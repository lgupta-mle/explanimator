# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter API key — used for all LLM calls (explanation, judge, codegen)
# and for Gemini TTS via OpenRouter. Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API key — only needed if you switch the TTS provider back to OpenAI
# in config.yaml (audio.provider: openai). Default config uses OpenRouter.
# OPENAI_API_KEY=sk-…

# OpenAI key is also used by the build_manim_index preprocessing script
# (text-embedding-3-large) — only required if you regenerate the RAG vector DB.
# The shipped vector DB at data/manim_docs/vector_db/chroma_db is pre-built.

# ─────────────────────────────────────────────────────────────────────────────
# Profile selection
# ─────────────────────────────────────────────────────────────────────────────

# Profile to overlay on config.yaml — one of: dev | staging | prod.
# Defaults to "dev" (see config/dev.yaml).
# ANVAYA_PROFILE=dev
