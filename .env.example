# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter API key — used for all LLM calls (explanation, judge, codegen)
# and for Gemini TTS via OpenRouter. Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API key — required for the Manim RAG lookups used during code-fix
# retries in Manim codegen. The vector DB is gitignored (not shipped in the
# repo) and must be built locally with
# `python -m research_viz.preprocessing.build_manim_index`. Note this key is
# needed at QUERY time too, not just when building the index — every RAG
# search re-embeds the query text via OpenAI's text-embedding-3-large, so
# there's no way to skip this key once the DB exists locally.
OPENAI_API_KEY=sk-…


# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────

# OPENAI_API_KEY above is also used to switch the TTS provider back to OpenAI
# in config.yaml (audio.provider: openai) — default config uses OpenRouter.

# ─────────────────────────────────────────────────────────────────────────────
# Profile selection
# ─────────────────────────────────────────────────────────────────────────────

# Profile to overlay on config.yaml — one of: dev | staging | prod.
# Defaults to "dev" (see config/dev.yaml).
# ANVAYA_PROFILE=dev
