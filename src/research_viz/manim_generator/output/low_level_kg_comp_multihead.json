  "composite_operations": [
    {
      "id": "comp_qkv_projection",
      "name": "QKV Projections",
      "description": "Parallel linear projections from model space to per-head Q, K, V spaces, each split into h heads.",
      "atomic_operations_involved": [
        "op_q_mm",
        "op_q_bias",
        "op_k_mm",
        "op_k_bias",
        "op_v_mm",
        "op_v_bias",
        "op_q_reshape",
        "op_q_transpose",
        "op_k_reshape",
        "op_k_transpose",
        "op_v_reshape",
        "op_v_transpose"
      ],
      "overall_formula": "Q = \\operatorname{reshape}(X_Q W_Q + b_Q, [B,S_q,h,d_k])\\;;\\; K = \\operatorname{reshape}(X_{KV} W_K + b_K, [B,S_{kv},h,d_k])\\;;\\; V = \\operatorname{reshape}(X_{KV} W_V + b_V, [B,S_{kv},h,d_v])",
      "why_grouped": "These steps always occur together to create per-head Q, K, and V tensors used by attention."
    },
    {
      "id": "comp_scaled_dot_product",
      "name": "Scaled Dot-Product Attention (per head)",
      "description": "The core attention operation: compute scores, scale, mask, normalize, and weight values.",
      "atomic_operations_involved": [
        "op_scores_matmul",
        "op_scores_scale",
        "op_add_masks",
        "op_scores_softmax",
        "op_attn_dropout",
        "op_weighted_sum"
      ],
      "overall_formula": "C_h = \\operatorname{softmax}\\!\\left(\\frac{Q_h K_h^{\\top}}{\\sqrt{d_k}} + M\\right) V_h",
      "why_grouped": "These operations form the standard attention kernel described as a single function in the paper."
    },
    {
      "id": "comp_multihead_assembly",
      "name": "Multi-Head Assembly and Output",
      "description": "Concatenates per-head contexts and applies a final linear projection back to model dimension.",
      "atomic_operations_involved": [
        "op_ctx_transpose",
        "op_ctx_reshape",
        "op_out_mm",
        "op_out_bias"
      ],
      "overall_formula": "Y = \\left[ C_h \\right]_{h=1}^H W_O + b_O",
      "why_grouped": "These steps convert per-head results into a single tensor suitable for downstream layers."
    }
  ],
