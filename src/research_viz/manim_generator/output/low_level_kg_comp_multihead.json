      "code_snippet": "W_qkv = torch.empty(d_model, 3*h*d_k).to(device)\nb_qkv = torch.zeros(3*h*d_k, device=device)\nqkv = X @ W_qkv + b_qkv\nQ, K, V = qkv.split([h*d_k, h*d_k, h*d_v], dim=-1)"
    },
    {
      "topic": "Use optimized attention kernels",
      "description": "Prefer PyTorch 2.x F.scaled_dot_product_attention or FlashAttention to fuse scaling, masking, softmax, dropout, and matmuls for improved speed and memory.",
