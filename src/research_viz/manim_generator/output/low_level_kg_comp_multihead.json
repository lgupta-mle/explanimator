  "implementation_hints": [
    {
      "topic": "Mask construction and broadcasting",
      "description": "Build an additive mask M that is broadcastable to [B, h, S_q, S_kv]. Combine padding and causal masks by summation to minimize kernel calls.",
      "affected_operations": [
        "op_add_masks"
      ],
      "code_snippet": "M = 0.0\nif causal:\n    causal_mask = torch.full((S_q, S_kv), float('-inf'), device=x.device)\n    causal_mask = torch.triu(causal_mask, diagonal=1)\n    M = M + causal_mask\nif key_padding_mask is not None:\n    M = M + key_padding_mask[:, None, None, :].to(x.dtype).masked_fill(key_padding_mask[:, None, None, :].bool(), float('-inf'))"
    },
    {
      "topic": "Fusing QKV projections",
      "description": "Use a single matmul to compute Q, K, V, then split along the last dimension for significant speedups.",
      "affected_operations": [
        "op_q_mm",
        "op_k_mm",
        "op_v_mm",
        "op_q_bias",
        "op_k_bias",
        "op_v_bias"
