{
  "component_id": "comp_multihead",
  "component_name": "Multi-Head Attention",
  "atomic_operations": [
    {
      "id": "op_q_mm",
      "name": "query_linear_matmul",
      "type": "matmul",
      "description": "Projects the query-side inputs into the query subspace via matrix multiplication. Produces a packed tensor that holds all heads before bias is added.",
      "mathematical_formula": "\\tilde{Q} = X_Q W_Q",
      "input_tensors": [
        {
          "name": "X_Q",
          "shape": "[batch, seq_q, d_model]",
          "dtype": "float32",
          "description": "Input tensor providing queries (encoder output or decoder hidden states)"
        },
        {
          "name": "W_Q",
          "shape": "[d_model, h\\cdot d_k]",
          "dtype": "float32",
          "description": "Query projection weights"
        }
      ],
      "output_tensors": [
        {
          "name": "Q_lin",
          "shape": "[batch, seq_q, h*d_k]",
          "dtype": "float32",
          "description": "Linearly projected queries before bias"
        }
      ],
      "parameters": [
        {
          "name": "W_Q",
          "shape": "[d_model, h*d_k]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Weight matrix for query projection"
        }
      ],
      "hyperparameters": [
        {
          "name": "h",
          "value": "8",
          "description": "Number of attention heads"
        },
        {
          "name": "d_k",
          "value": "64",
          "description": "Per-head query/key dimension"
        },
        {
          "name": "d_model",
          "value": "512",
          "description": "Model width"
        }
      ],
      "computational_complexity": "O(batch * seq_q * d_model * h*d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_q_bias",
      "name": "query_bias_add",
      "type": "elementwise",
      "description": "Adds a learnable bias to the linearly projected queries. Broadcasts bias across batch and sequence dimensions.",
      "mathematical_formula": "Q = \\tilde{Q} + b_Q",
      "input_tensors": [
        {
          "name": "Q_lin",
          "shape": "[batch, seq_q, h*d_k]",
          "dtype": "float32",
          "description": "Projected queries before bias"
        },
        {
          "name": "b_Q",
          "shape": "[h*d_k]",
          "dtype": "float32",
          "description": "Query projection bias"
        }
      ],
      "output_tensors": [
        {
          "name": "Q",
          "shape": "[batch, seq_q, h*d_k]",
          "dtype": "float32",
          "description": "Biased query projections"
        }
      ],
      "parameters": [
        {
          "name": "b_Q",
          "shape": "[h*d_k]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Bias for query projection"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * seq_q * h*d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_mm",
      "name": "key_linear_matmul",
      "type": "matmul",
      "description": "Projects the key-side inputs into the key subspace via matrix multiplication. Supports cross-attention by allowing a different source for keys/values.",
      "mathematical_formula": "\\tilde{K} = X_KV W_K",
      "input_tensors": [
        {
          "name": "X_KV",
          "shape": "[batch, seq_kv, d_model]",
          "dtype": "float32",
          "description": "Input tensor providing keys/values (same as X_Q for self-attention)"
        },
        {
          "name": "W_K",
          "shape": "[d_model, h\\cdot d_k]",
          "dtype": "float32",
          "description": "Key projection weights"
        }
      ],
      "output_tensors": [
        {
          "name": "K_lin",
          "shape": "[batch, seq_kv, h*d_k]",
          "dtype": "float32",
          "description": "Linearly projected keys before bias"
        }
      ],
      "parameters": [
        {
          "name": "W_K",
          "shape": "[d_model, h*d_k]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Weight matrix for key projection"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * seq_kv * d_model * h*d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_bias",
      "name": "key_bias_add",
      "type": "elementwise",
      "description": "Adds a learnable bias to the linearly projected keys. Bias is broadcast across batch and sequence.",
      "mathematical_formula": "K = \\tilde{K} + b_K",
      "input_tensors": [
        {
          "name": "K_lin",
          "shape": "[batch, seq_kv, h*d_k]",
          "dtype": "float32",
          "description": "Projected keys before bias"
        },
        {
          "name": "b_K",
          "shape": "[h*d_k]",
          "dtype": "float32",
          "description": "Key projection bias"
        }
      ],
      "output_tensors": [
        {
          "name": "K",
          "shape": "[batch, seq_kv, h*d_k]",
          "dtype": "float32",
          "description": "Biased key projections"
        }
      ],
      "parameters": [
        {
          "name": "b_K",
          "shape": "[h*d_k]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Bias for key projection"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * seq_kv * h*d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_mm",
      "name": "value_linear_matmul",
      "type": "matmul",
      "description": "Projects the value-side inputs into the value subspace via matrix multiplication. Typically d_v = d_k for Transformer-base.",
      "mathematical_formula": "\\tilde{V} = X_KV W_V",
      "input_tensors": [
        {
          "name": "X_KV",
          "shape": "[batch, seq_kv, d_model]",
          "dtype": "float32",
          "description": "Input tensor providing keys/values"
        },
        {
          "name": "W_V",
          "shape": "[d_model, h\\cdot d_v]",
          "dtype": "float32",
          "description": "Value projection weights"
        }
      ],
      "output_tensors": [
        {
          "name": "V_lin",
          "shape": "[batch, seq_kv, h*d_v]",
          "dtype": "float32",
          "description": "Linearly projected values before bias"
        }
      ],
      "parameters": [
        {
          "name": "W_V",
          "shape": "[d_model, h*d_v]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Weight matrix for value projection"
        }
      ],
      "hyperparameters": [
        {
          "name": "d_v",
          "value": "64",
          "description": "Per-head value dimension"
        }
      ],
      "computational_complexity": "O(batch * seq_kv * d_model * h*d_v)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_bias",
      "name": "value_bias_add",
      "type": "elementwise",
      "description": "Adds a learnable bias to the linearly projected values.",
      "mathematical_formula": "V = \\tilde{V} + b_V",
      "input_tensors": [
        {
          "name": "V_lin",
          "shape": "[batch, seq_kv, h*d_v]",
          "dtype": "float32",
          "description": "Projected values before bias"
        },
        {
          "name": "b_V",
          "shape": "[h*d_v]",
          "dtype": "float32",
          "description": "Value projection bias"
        }
      ],
      "output_tensors": [
        {
          "name": "V",
          "shape": "[batch, seq_kv, h*d_v]",
          "dtype": "float32",
          "description": "Biased value projections"
        }
      ],
      "parameters": [
        {
          "name": "b_V",
          "shape": "[h*d_v]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Bias for value projection"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * seq_kv * h*d_v)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_q_reshape",
      "name": "query_split_heads_reshape",
      "type": "reshape",
      "description": "Reshapes the packed query dimension to separate heads. Converts the last dimension from h*d_k to [h, d_k].",
      "mathematical_formula": "Q' = \\text{reshape}(Q, [B, S_q, h, d_k])",
      "input_tensors": [
        {
          "name": "Q",
          "shape": "[batch, seq_q, h*d_k]",
          "dtype": "float32",
          "description": "Packed queries"
        }
      ],
      "output_tensors": [
        {
          "name": "Q_heads_seq_last",
          "shape": "[batch, seq_q, h, d_k]",
          "dtype": "float32",
          "description": "Queries with explicit head dimension"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_q_transpose",
      "name": "query_heads_to_bhsd",
      "type": "reshape",
      "description": "Permutes dimensions to [batch, heads, seq, d_k] for efficient batched matmul across heads.",
      "mathematical_formula": "Q_h = \\text{transpose}(Q', [0,2,1,3])",
      "input_tensors": [
        {
          "name": "Q_heads_seq_last",
          "shape": "[batch, seq_q, h, d_k]",
          "dtype": "float32",
          "description": "Queries with head dimension"
        }
      ],
      "output_tensors": [
        {
          "name": "Q_h",
          "shape": "[batch, h, seq_q, d_k]",
          "dtype": "float32",
          "description": "Queries ready for attention matmul"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_reshape",
      "name": "key_split_heads_reshape",
      "type": "reshape",
      "description": "Reshapes the packed key dimension to separate heads.",
      "mathematical_formula": "K' = \\text{reshape}(K, [B, S_{kv}, h, d_k])",
      "input_tensors": [
        {
          "name": "K",
          "shape": "[batch, seq_kv, h*d_k]",
          "dtype": "float32",
          "description": "Packed keys"
        }
      ],
      "output_tensors": [
        {
          "name": "K_heads_seq_last",
          "shape": "[batch, seq_kv, h, d_k]",
          "dtype": "float32",
          "description": "Keys with head dimension"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_transpose",
      "name": "key_heads_to_bhsd",
      "type": "reshape",
      "description": "Permutes dimensions to [batch, heads, seq_kv, d_k] for batched attention.",
      "mathematical_formula": "K_h = \\text{transpose}(K', [0,2,1,3])",
      "input_tensors": [
        {
          "name": "K_heads_seq_last",
          "shape": "[batch, seq_kv, h, d_k]",
          "dtype": "float32",
          "description": "Keys with head dimension"
        }
      ],
      "output_tensors": [
        {
          "name": "K_h",
          "shape": "[batch, h, seq_kv, d_k]",
          "dtype": "float32",
          "description": "Keys ready for attention matmul"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_reshape",
      "name": "value_split_heads_reshape",
      "type": "reshape",
      "description": "Reshapes the packed value dimension to separate heads.",
      "mathematical_formula": "V' = \\text{reshape}(V, [B, S_{kv}, h, d_v])",
      "input_tensors": [
        {
          "name": "V",
          "shape": "[batch, seq_kv, h*d_v]",
          "dtype": "float32",
          "description": "Packed values"
        }
      ],
      "output_tensors": [
        {
          "name": "V_heads_seq_last",
          "shape": "[batch, seq_kv, h, d_v]",
          "dtype": "float32",
          "description": "Values with head dimension"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_transpose",
      "name": "value_heads_to_bhsd",
      "type": "reshape",
      "description": "Permutes dimensions to [batch, heads, seq_kv, d_v] for batched attention.",
      "mathematical_formula": "V_h = \\text{transpose}(V', [0,2,1,3])",
      "input_tensors": [
        {
          "name": "V_heads_seq_last",
          "shape": "[batch, seq_kv, h, d_v]",
          "dtype": "float32",
          "description": "Values with head dimension"
        }
      ],
      "output_tensors": [
        {
          "name": "V_h",
          "shape": "[batch, h, seq_kv, d_v]",
          "dtype": "float32",
          "description": "Values ready for attention weighting"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_scores_matmul",
      "name": "attention_scores_matmul",
      "type": "matmul",
      "description": "Computes raw attention scores for each head via batched matrix multiplication of queries with transposed keys. Measures compatibility of each query with every key.",
      "mathematical_formula": "S = Q_h K_h^{\\top}",
      "input_tensors": [
        {
          "name": "Q_h",
          "shape": "[batch, h, seq_q, d_k]",
          "dtype": "float32",
          "description": "Per-head queries"
        },
        {
          "name": "K_h",
          "shape": "[batch, h, seq_kv, d_k]",
          "dtype": "float32",
          "description": "Per-head keys"
        }
      ],
      "output_tensors": [
        {
          "name": "scores",
          "shape": "[batch, h, seq_q, seq_kv]",
          "dtype": "float32",
          "description": "Raw attention scores"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * seq_q * seq_kv * d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_scores_scale",
      "name": "scale_scores_by_sqrt_dk",
      "type": "elementwise",
      "description": "Scales the raw attention scores by 1/sqrt(d_k) to prevent softmax saturation at large dimensions. Applied element-wise across all heads and positions.",
      "mathematical_formula": "S_{scaled} = \\frac{S}{\\sqrt{d_k}}",
      "input_tensors": [
        {
          "name": "scores",
          "shape": "[batch, h, seq_q, seq_kv]",
          "dtype": "float32",
          "description": "Raw attention scores"
        }
      ],
      "output_tensors": [
        {
          "name": "scores_scaled",
          "shape": "[batch, h, seq_q, seq_kv]",
          "dtype": "float32",
          "description": "Scaled attention scores"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "d_k",
          "value": "64",
          "description": "Per-head key/query dimension used for scaling"
        }
      ],
      "computational_complexity": "O(batch * h * seq_q * seq_kv)",
      "numerical_stability_notes": "Scaling reduces magnitude to improve softmax gradients"
    },
    {
      "id": "op_add_masks",
      "name": "add_attention_masks",
      "type": "elementwise",
      "description": "Adds an additive mask to scaled scores prior to softmax. Supports padding masks and optional causal masks by adding a large negative number (e.g., -1e9) at masked positions.",
      "mathematical_formula": "S_{masked} = S_{scaled} + M",
      "input_tensors": [
        {
          "name": "scores_scaled",
          "shape": "[batch, h, seq_q, seq_kv]",
          "dtype": "float32",
          "description": "Scaled attention scores"
        },
        {
          "name": "M",
          "shape": "[batch, 1 or h, seq_q, seq_kv]",
          "dtype": "float32",
          "description": "Additive attention mask (0 for valid, -\\infty for masked; broadcastable over heads)"
        }
      ],
      "output_tensors": [
        {
          "name": "scores_masked",
          "shape": "[batch, h, seq_q, seq_kv]",
          "dtype": "float32",
          "description": "Masked scores passed to softmax"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * seq_q * seq_kv)",
      "numerical_stability_notes": "Use a large negative constant that is representable in dtype (e.g., -1e9 for fp32, -1e4 for fp16) to avoid NaNs"
    },
    {
      "id": "op_scores_softmax",
      "name": "scores_rowwise_softmax",
      "type": "activation",
      "description": "Applies a row-wise softmax over the last dimension to turn masked scores into attention probabilities for each query position and head.",
      "mathematical_formula": "A = \\operatorname{softmax}(S_{masked}) = \\frac{\\exp(S_{masked} - \\max(S_{masked},\\text{axis}=-1))}{\\sum_j \\exp(S_{masked} - \\max(S_{masked},\\text{axis}=-1))}",
      "input_tensors": [
        {
          "name": "scores_masked",
          "shape": "[batch, h, seq_q, seq_kv]",
          "dtype": "float32",
          "description": "Masked attention scores"
        }
      ],
      "output_tensors": [
        {
          "name": "attn_probs",
          "shape": "[batch, h, seq_q, seq_kv]",
          "dtype": "float32",
          "description": "Attention probability distribution"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * seq_q * seq_kv)",
      "numerical_stability_notes": "Use max-subtraction before exp to prevent overflow; compute softmax in float32 even under mixed precision"
    },
    {
      "id": "op_attn_dropout",
      "name": "attention_weights_dropout",
      "type": "dropout",
      "description": "Randomly drops a fraction of attention probabilities during training for regularization. During inference, this operation is a no-op.",
      "mathematical_formula": "A' = \\mathrm{Dropout}(A; p)",
      "input_tensors": [
        {
          "name": "attn_probs",
          "shape": "[batch, h, seq_q, seq_kv]",
          "dtype": "float32",
          "description": "Attention probabilities"
        }
      ],
      "output_tensors": [
        {
          "name": "attn_probs_do",
          "shape": "[batch, h, seq_q, seq_kv]",
          "dtype": "float32",
          "description": "Attention probabilities after dropout"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "dropout_attn",
          "value": "0.1",
          "description": "Dropout rate for attention weights"
        },
        {
          "name": "training",
          "value": "true/false",
          "description": "Enables dropout only during training"
        }
      ],
      "computational_complexity": "O(batch * h * seq_q * seq_kv)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_weighted_sum",
      "name": "apply_attention_to_values",
      "type": "matmul",
      "description": "Computes the per-head context vectors as the weighted sum of values using attention probabilities.",
      "mathematical_formula": "C_h = A' V_h",
      "input_tensors": [
        {
          "name": "attn_probs_do",
          "shape": "[batch, h, seq_q, seq_kv]",
          "dtype": "float32",
          "description": "Attention probabilities per head"
        },
        {
          "name": "V_h",
          "shape": "[batch, h, seq_kv, d_v]",
          "dtype": "float32",
          "description": "Per-head values"
        }
      ],
      "output_tensors": [
        {
          "name": "contexts_h",
          "shape": "[batch, h, seq_q, d_v]",
          "dtype": "float32",
          "description": "Per-head context vectors"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * seq_q * seq_kv * d_v)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_ctx_transpose",
      "name": "transpose_contexts_to_bshd",
      "type": "reshape",
      "description": "Moves the head dimension after sequence to prepare for concatenation by reshape.",
      "mathematical_formula": "C' = \\text{transpose}(C_h, [0,2,1,3])",
      "input_tensors": [
        {
          "name": "contexts_h",
          "shape": "[batch, h, seq_q, d_v]",
          "dtype": "float32",
          "description": "Per-head context vectors"
        }
      ],
      "output_tensors": [
        {
          "name": "contexts_seq_heads_last",
          "shape": "[batch, seq_q, h, d_v]",
          "dtype": "float32",
          "description": "Contexts transposed for merge"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_ctx_reshape",
      "name": "merge_heads_concat",
      "type": "reshape",
      "description": "Concatenates per-head context vectors by reshaping [h, d_v] into a single last dimension. Produces a tensor at model width when h*d_v = d_model.",
      "mathematical_formula": "C = \\text{reshape}(C', [B, S_q, h\\cdot d_v])",
      "input_tensors": [
        {
          "name": "contexts_seq_heads_last",
          "shape": "[batch, seq_q, h, d_v]",
          "dtype": "float32",
          "description": "Contexts with head dimension"
        }
      ],
      "output_tensors": [
        {
          "name": "concat_context",
          "shape": "[batch, seq_q, h*d_v]",
          "dtype": "float32",
          "description": "Concatenated multi-head context"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_out_mm",
      "name": "output_projection_matmul",
      "type": "matmul",
      "description": "Projects concatenated contexts back to model dimension via an output weight matrix. This mixes information across heads.",
      "mathematical_formula": "\\tilde{Y} = C W_O",
      "input_tensors": [
        {
          "name": "concat_context",
          "shape": "[batch, seq_q, h*d_v]",
          "dtype": "float32",
          "description": "Concatenated context from all heads"
        },
        {
          "name": "W_O",
          "shape": "[h\\cdot d_v, d_model]",
          "dtype": "float32",
          "description": "Output projection weights"
        }
      ],
      "output_tensors": [
        {
          "name": "Y_lin",
          "shape": "[batch, seq_q, d_model]",
          "dtype": "float32",
          "description": "Projected outputs before bias"
        }
      ],
      "parameters": [
        {
          "name": "W_O",
          "shape": "[h*d_v, d_model]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Output projection matrix"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * seq_q * h*d_v * d_model)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_out_bias",
      "name": "output_projection_bias_add",
      "type": "elementwise",
      "description": "Adds bias to the output projection result to form the final multi-head attention output. The parent sublayer may apply dropout after this step.",
