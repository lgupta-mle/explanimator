{
  "component_id": "comp_scaled_dot_prod",
  "component_name": "Scaled Dot-Product Attention",
  "atomic_operations": [
    {
      "id": "op_cast_inputs_fp32",
      "name": "cast_inputs_to_fp32_for_logits",
      "type": "reshape",
      "description": "Optionally cast Q, K, V to float32 for numerically stable logit/softmax computation when running in mixed precision. Keeps original dtype for a later cast-back.",
      "mathematical_formula": "Q^{(32)} = \\text{astype}(Q, \\text{float32});\\; K^{(32)} = \\text{astype}(K, \\text{float32});\\; V^{(32)} = \\text{astype}(V, \\text{float32})",
      "input_tensors": [
        {
          "name": "Q",
          "shape": "[batch, num_heads, seq_q, d_k]",
          "dtype": "float16|bfloat16|float32",
          "description": "Query tensor per head"
        },
        {
          "name": "K",
          "shape": "[batch, num_heads, seq_k, d_k]",
          "dtype": "float16|bfloat16|float32",
          "description": "Key tensor per head"
        },
        {
          "name": "V",
          "shape": "[batch, num_heads, seq_k, d_v]",
          "dtype": "float16|bfloat16|float32",
          "description": "Value tensor per head"
        }
      ],
      "output_tensors": [
        {
          "name": "Q32",
          "shape": "[batch, num_heads, seq_q, d_k]",
          "dtype": "float32",
          "description": "Query in float32 (for logits math)"
        },
        {
          "name": "K32",
          "shape": "[batch, num_heads, seq_k, d_k]",
          "dtype": "float32",
          "description": "Key in float32"
        },
        {
          "name": "V32",
          "shape": "[batch, num_heads, seq_k, d_v]",
          "dtype": "float32",
          "description": "Value in float32 (for weighted sum)"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": "Casting logits computation to float32 prevents overflow/underflow in softmax for long sequences or large d_k."
    },
    {
      "id": "op_transpose_k",
      "name": "transpose_keys_for_matmul",
      "type": "reshape",
      "description": "Transpose the last two dimensions of K to prepare for QK^T batched matmul across heads and batch.",
      "mathematical_formula": "K^T = \\text{transpose}(K32, [-1, -2])",
      "input_tensors": [
        {
          "name": "K32",
          "shape": "[batch, num_heads, seq_k, d_k]",
          "dtype": "float32",
          "description": "Key tensor per head"
        }
      ],
      "output_tensors": [
        {
          "name": "K_t",
          "shape": "[batch, num_heads, d_k, seq_k]",
          "dtype": "float32",
          "description": "Transposed keys for dot products"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_qk_matmul",
      "name": "compute_attention_logits",
      "type": "matmul",
      "description": "Compute raw attention logits as batched matrix multiplication between queries and transposed keys for each head and batch sample.",
      "mathematical_formula": "L = Q32 \\times K^T",
      "input_tensors": [
        {
          "name": "Q32",
          "shape": "[batch, num_heads, seq_q, d_k]",
          "dtype": "float32",
          "description": "Queries"
        },
        {
          "name": "K_t",
          "shape": "[batch, num_heads, d_k, seq_k]",
          "dtype": "float32",
          "description": "Transposed keys"
        }
      ],
      "output_tensors": [
        {
          "name": "logits_raw",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Unscaled attention logits"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * seq_q * seq_k * d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_scale_logits",
      "name": "scale_attention_logits",
      "type": "elementwise",
      "description": "Scale the raw logits by the inverse square root of the key dimensionality to keep softmax in a region with larger gradients.",
      "mathematical_formula": "L_s = \\frac{L}{\\sqrt{d_k}}",
      "input_tensors": [
        {
          "name": "logits_raw",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Unscaled logits"
        }
      ],
      "output_tensors": [
        {
          "name": "logits_scaled",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Scaled logits before masking"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "d_k",
          "value": "symbolic",
          "description": "Key dimensionality used in scaling"
        }
      ],
      "computational_complexity": "O(batch * num_heads * seq_q * seq_k)",
      "numerical_stability_notes": "Scaling mitigates softmax saturation for large d_k."
    },
    {
      "id": "op_prepare_padding_mask",
      "name": "prepare_additive_padding_mask",
      "type": "reshape",
      "description": "Convert a boolean key padding mask into an additive mask that broadcasts over heads and query positions. True (pad) becomes -inf, False becomes 0.",
      "mathematical_formula": "M_{pad}^{add}[b,1,1,j] = \\begin{cases}-\\infty & \\text{if }\\text{pad}[b,j]=\\text{True}\\\\0 & \\text{otherwise}\\end{cases}",
      "input_tensors": [
        {
          "name": "key_padding_mask",
          "shape": "[batch, seq_k]",
          "dtype": "bool",
          "description": "True where key position is padding (optional)"
        }
      ],
      "output_tensors": [
        {
          "name": "M_pad_add",
          "shape": "[batch, 1, 1, seq_k]",
          "dtype": "float32",
          "description": "Broadcastable additive mask for padding"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * seq_k)",
      "numerical_stability_notes": "If -inf is not representable, use a large negative sentinel like -1e9."
    },
    {
      "id": "op_prepare_causal_mask",
      "name": "prepare_causal_mask",
      "type": "reshape",
      "description": "Create an upper-triangular mask to prevent attention to future keys (for autoregressive decoding). 1 on illegal (future) positions, else 0. Convert to additive form.",
      "mathematical_formula": "M_{causal}^{add}[1,1,i,j] = \\begin{cases}-\\infty & j>i \\\\ 0 & \\text{otherwise}\\end{cases}",
      "input_tensors": [
        {
          "name": "shape_info",
          "shape": "[seq_q, seq_k]",
          "dtype": "int64",
          "description": "Sequence lengths to size the mask"
        }
      ],
      "output_tensors": [
        {
          "name": "M_causal_add",
          "shape": "[1, 1, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Additive causal mask"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "use_causal_mask",
          "value": "true|false",
          "description": "Enable for decoder self-attention"
        }
      ],
      "computational_complexity": "O(seq_q * seq_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_prepare_attn_bias",
      "name": "prepare_custom_attention_bias",
      "type": "reshape",
      "description": "Optional external attention bias (e.g., relative position bias or user-provided mask) is broadcast or reshaped to [batch, num_heads, seq_q, seq_k].",
      "mathematical_formula": "M_{ext}^{add} = \\text{broadcast}(M_{ext}, [batch, num\\_heads, seq\\_q, seq\\_k])",
      "input_tensors": [
        {
          "name": "attn_mask_or_bias",
          "shape": "[seq_q, seq_k] or [batch, 1, seq_q, seq_k] or [batch, num_heads, seq_q, seq_k]",
          "dtype": "float32|float16|bfloat16",
          "description": "Optional additive mask/bias (0 for allowed, -inf for disallowed)"
        }
      ],
      "output_tensors": [
        {
          "name": "M_ext_add",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Broadcast additive bias"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_merge_masks",
      "name": "merge_additive_masks",
      "type": "elementwise",
      "description": "Combine available additive masks (padding, causal, external) via element-wise addition with broadcasting. Missing masks are treated as zeros.",
      "mathematical_formula": "M^{add} = \\text{broadcast\\_to}(M_{pad}^{add}) + \\text{broadcast\\_to}(M_{causal}^{add}) + \\text{broadcast\\_to}(M_{ext}^{add})",
      "input_tensors": [
        {
          "name": "M_pad_add",
          "shape": "[batch, 1, 1, seq_k]",
          "dtype": "float32",
          "description": "Padding additive mask (optional)"
        },
        {
          "name": "M_causal_add",
          "shape": "[1, 1, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Causal additive mask (optional)"
        },
        {
          "name": "M_ext_add",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "External additive mask/bias (optional)"
        }
      ],
      "output_tensors": [
        {
          "name": "M_add",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Combined additive mask"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * seq_q * seq_k)",
      "numerical_stability_notes": "If using float16 math, clamp the combined mask minimum to -1e9 to avoid NaNs."
    },
    {
      "id": "op_apply_mask",
      "name": "apply_additive_mask_to_logits",
      "type": "elementwise",
      "description": "Add the combined additive mask to the scaled logits. Masked positions receive a large negative value so their softmax probability becomes ~0.",
      "mathematical_formula": "L_m = L_s + M^{add}",
      "input_tensors": [
        {
          "name": "logits_scaled",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Scaled logits"
        },
        {
          "name": "M_add",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Combined additive mask"
        }
      ],
      "output_tensors": [
        {
          "name": "logits_masked",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Masked logits"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * seq_q * seq_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_softmax_stabilize",
      "name": "softmax_max_subtraction",
      "type": "reduction",
      "description": "Improve numerical stability by subtracting the per-row maximum from logits before exponentiation. This does not change the softmax result.",
      "mathematical_formula": "L' = L_m - \\max_{j}(L_m)\\;\\;\\text{(max over last dim j)}",
      "input_tensors": [
        {
          "name": "logits_masked",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Masked logits"
        }
      ],
      "output_tensors": [
        {
          "name": "logits_centered",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Logits with row-wise max subtracted"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * seq_q * seq_k)",
      "numerical_stability_notes": "This is the standard LogSumExp trick part 1."
    },
    {
      "id": "op_softmax_exp",
      "name": "softmax_exponentiate",
      "type": "activation",
      "description": "Exponentiate centered logits element-wise.",
      "mathematical_formula": "E = \\exp(L')",
      "input_tensors": [
        {
          "name": "logits_centered",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Centered logits"
        }
      ],
      "output_tensors": [
        {
          "name": "exp_logits",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Exponentiated logits"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * seq_q * seq_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_softmax_normalize",
      "name": "softmax_normalize",
      "type": "reduction",
      "description": "Normalize exponentiated logits along the key dimension to obtain attention probabilities.",
      "mathematical_formula": "A = \\frac{E}{\\sum_{j} E_{...,j}}",
      "input_tensors": [
        {
          "name": "exp_logits",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Exponentiated logits"
        }
      ],
      "output_tensors": [
        {
          "name": "attn_weights",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Row-wise normalized attention probabilities"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * seq_q * seq_k)",
      "numerical_stability_notes": "Denominator uses sum along last dim; add tiny epsilon if framework exposes it to avoid 0 division in pathological masks."
    },
    {
      "id": "op_attention_dropout",
      "name": "dropout_on_attention_weights",
      "type": "dropout",
      "description": "Apply dropout to attention probabilities for regularization during training. Scale by 1/(1-p) to keep expectation constant.",
      "mathematical_formula": "A' = \\frac{\\text{Bernoulli}(1-p) \\odot A}{1-p} \\;\\;\\text{(training)},\\; A' = A \\;\\text{(inference)}",
      "input_tensors": [
        {
          "name": "attn_weights",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Attention probabilities"
        }
      ],
      "output_tensors": [
        {
          "name": "attn_weights_drop",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Regularized attention probabilities"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "dropout_rate",
          "value": "0.1",
          "description": "Typical value from Transformer base"
        }
      ],
      "computational_complexity": "O(batch * num_heads * seq_q * seq_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_weighted_sum",
      "name": "weighted_sum_of_values",
      "type": "matmul",
      "description": "Multiply attention probabilities by values to produce per-head context vectors for each query position.",
      "mathematical_formula": "O = A' \\times V32",
      "input_tensors": [
        {
          "name": "attn_weights_drop",
          "shape": "[batch, num_heads, seq_q, seq_k]",
          "dtype": "float32",
          "description": "Attention probabilities"
        },
        {
          "name": "V32",
          "shape": "[batch, num_heads, seq_k, d_v]",
          "dtype": "float32",
          "description": "Values"
        }
      ],
      "output_tensors": [
        {
          "name": "context32",
          "shape": "[batch, num_heads, seq_q, d_v]",
          "dtype": "float32",
          "description": "Per-head attention outputs"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * seq_q * seq_k * d_v)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_cast_output_back",
      "name": "cast_output_to_input_dtype",
      "type": "reshape",
      "description": "Cast the attention output back to the original compute dtype if mixed precision was used.",
      "mathematical_formula": "\\text{context} = \\text{astype}(\\text{context32}, \\text{dtype}(Q))",
      "input_tensors": [
        {
          "name": "context32",
          "shape": "[batch, num_heads, seq_q, d_v]",
          "dtype": "float32",
          "description": "Context vectors in float32"
        },
        {
          "name": "Q",
          "shape": "[batch, num_heads, seq_q, d_k]",
          "dtype": "float16|bfloat16|float32",
          "description": "Original query (for dtype reference)"
        }
      ],
      "output_tensors": [
        {
          "name": "context",
          "shape": "[batch, num_heads, seq_q, d_v]",
          "dtype": "float16|bfloat16|float32",
          "description": "Final attention output per head"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    }
  ],
  "data_flow": [
    {
      "step": 1,
      "operation_id": "op_cast_inputs_fp32",
      "input_from": [
        "component_input"
      ],
      "output_to": [
        "op_transpose_k"
      ],
      "intermediate_result": "Q, K, V promoted to float32 for stable softmax math",
      "tensor_shape_at_step": "Q32:[batch,num_heads,seq_q,d_k], K32:[batch,num_heads,seq_k,d_k], V32:[batch,num_heads,seq_k,d_v]",
      "notes": "Skip if already float32 or if using a fused kernel that handles mixed precision."
    },
    {
      "step": 2,
      "operation_id": "op_transpose_k",
      "input_from": [
        "op_cast_inputs_fp32"
      ],
      "output_to": [
        "op_qk_matmul"
      ],
      "intermediate_result": "Keys transposed for dot product",
      "tensor_shape_at_step": "K_t:[batch,num_heads,d_k,seq_k]",
      "notes": null
    },
    {
      "step": 3,
      "operation_id": "op_qk_matmul",
      "input_from": [
        "op_cast_inputs_fp32",
        "op_transpose_k"
      ],
      "output_to": [
        "op_scale_logits"
      ],
      "intermediate_result": "Raw attention logits L",
      "tensor_shape_at_step": "logits_raw:[batch,num_heads,seq_q,seq_k]",
      "notes": "Batched matmul across batch and head dims"
    },
    {
      "step": 4,
      "operation_id": "op_scale_logits",
      "input_from": [
        "op_qk_matmul"
      ],
      "output_to": [
        "op_merge_masks"
      ],
      "intermediate_result": "Scaled logits L_s",
      "tensor_shape_at_step": "logits_scaled:[batch,num_heads,seq_q,seq_k]",
      "notes": "Scale factor 1/sqrt(d_k)"
    },
    {
      "step": 5,
      "operation_id": "op_prepare_padding_mask",
      "input_from": [
        "component_input"
      ],
      "output_to": [
        "op_merge_masks"
      ],
      "intermediate_result": "Padding mask converted to additive form",
      "tensor_shape_at_step": "M_pad_add:[batch,1,1,seq_k]",
      "notes": "Optional; may be absent"
    },
    {
      "step": 6,
      "operation_id": "op_prepare_causal_mask",
      "input_from": [
        "component_input"
      ],
      "output_to": [
        "op_merge_masks"
      ],
      "intermediate_result": "Causal mask in additive form",
      "tensor_shape_at_step": "M_causal_add:[1,1,seq_q,seq_k]",
      "notes": "Only for decoder self-attention"
    },
    {
      "step": 7,
      "operation_id": "op_prepare_attn_bias",
      "input_from": [
        "component_input"
      ],
      "output_to": [
        "op_merge_masks"
      ],
      "intermediate_result": "External/additional attention bias broadcasted",
      "tensor_shape_at_step": "M_ext_add:[batch,num_heads,seq_q,seq_k]",
      "notes": "Optional"
    },
    {
      "step": 8,
      "operation_id": "op_merge_masks",
      "input_from": [
        "op_prepare_padding_mask",
        "op_prepare_causal_mask",
        "op_prepare_attn_bias"
      ],
      "output_to": [
        "op_apply_mask"
      ],
      "intermediate_result": "Combined additive mask M_add",
      "tensor_shape_at_step": "M_add:[batch,num_heads,seq_q,seq_k]",
      "notes": "Absent masks treated as zeros"
    },
    {
      "step": 9,
      "operation_id": "op_apply_mask",
      "input_from": [
        "op_scale_logits",
        "op_merge_masks"
      ],
      "output_to": [
        "op_softmax_stabilize"
      ],
      "intermediate_result": "Masked logits L_m",
      "tensor_shape_at_step": "logits_masked:[batch,num_heads,seq_q,seq_k]",
      "notes": "Masked entries very negative"
    },
    {
      "step": 10,
      "operation_id": "op_softmax_stabilize",
      "input_from": [
        "op_apply_mask"
      ],
      "output_to": [
        "op_softmax_exp"
      ],
      "intermediate_result": "Row-wise centered logits",
      "tensor_shape_at_step": "logits_centered:[batch,num_heads,seq_q,seq_k]",
      "notes": "Subtract max along last dim"
    },
    {
      "step": 11,
      "operation_id": "op_softmax_exp",
      "input_from": [
        "op_softmax_stabilize"
      ],
      "output_to": [
        "op_softmax_normalize"
      ],
      "intermediate_result": "Exponentiated logits",
      "tensor_shape_at_step": "exp_logits:[batch,num_heads,seq_q,seq_k]",
      "notes": null
    },
    {
      "step": 12,
      "operation_id": "op_softmax_normalize",
      "input_from": [
        "op_softmax_exp"
      ],
      "output_to": [
        "op_attention_dropout"
      ],
      "intermediate_result": "Attention probabilities A",
      "tensor_shape_at_step": "attn_weights:[batch,num_heads,seq_q,seq_k]",
      "notes": "Each row sums to 1"
    },
    {
      "step": 13,
      "operation_id": "op_attention_dropout",
      "input_from": [
        "op_softmax_normalize"
      ],
      "output_to": [
        "op_weighted_sum"
      ],
      "intermediate_result": "Regularized attention probabilities A'",
      "tensor_shape_at_step": "attn_weights_drop:[batch,num_heads,seq_q,seq_k]",
      "notes": "No-op in inference"
    },
    {
      "step": 14,
      "operation_id": "op_weighted_sum",
      "input_from": [
        "op_attention_dropout",
        "op_cast_inputs_fp32"
      ],
      "output_to": [
        "op_cast_output_back",
        "component_output"
      ],
      "intermediate_result": "Per-head context vectors O in float32",
      "tensor_shape_at_step": "context32:[batch,num_heads,seq_q,d_v]",
      "notes": "Batched matmul across last two dims"
    },
    {
      "step": 15,
      "operation_id": "op_cast_output_back",
      "input_from": [
        "op_weighted_sum",
        "component_input"
      ],
      "output_to": [
        "component_output"
