      "code_snippet": "QKV = X @ W_qkv + b_qkv  # W_qkv: [d_model, 3*h*d_k]\nQ, K, V = QKV.split([h*d_k, h*d_k, h*d_v], dim=-1)"
    },
    {
      "topic": "Use fused SDPA kernels",
      "description": "If available (e.g., PyTorch 2.x scaled_dot_product_attention / FlashAttention), delegate scaling, masking, softmax and weighted sum to a single optimized kernel.",
      "affected_operations": [
