  "composite_operations": [
    {
      "id": "comp_qkv_proj",
      "name": "QKV Projection",
      "description": "Parallel affine projections of the encoder input into query, key, and value spaces for all heads.",
      "atomic_operations_involved": [
        "op_q_proj",
        "op_k_proj",
        "op_v_proj"
      ],
      "overall_formula": "Q = X W_Q + b_Q,\\quad K = X W_K + b_K,\\quad V = X W_V + b_V",
      "why_grouped": "These three projections are always computed together and can be implemented as a single fused linear for efficiency."
    },
    {
      "id": "comp_scaled_dot_product",
      "name": "Scaled Dot-Product Attention (per head)",
      "description": "Computes attention logits, applies scaling and masking, normalizes via softmax, and aggregates values.",
      "atomic_operations_involved": [
        "op_scores",
        "op_scale",
        "op_add_padding_mask",
        "op_softmax",
        "op_attn_dropout",
        "op_weighted_sum"
      ],
      "overall_formula": "\\text{Attention}(Q,K,V) = \\text{softmax}\\!\\left(\\frac{QK^T}{\\sqrt{d_k}} + M_{pad}\\right)V",
      "why_grouped": "This is the fundamental attention mechanism used in each head."
    },
    {
      "id": "comp_multihead_attention",
      "name": "Multi-Head Self-Attention (encoder)",
      "description": "Runs scaled dot-product attention in h parallel heads on self inputs, then concatenates and projects back to model dimension.",
      "atomic_operations_involved": [
        "op_q_proj",
        "op_k_proj",
        "op_v_proj",
        "op_q_reshape",
        "op_q_transpose",
        "op_k_reshape",
        "op_k_transpose",
        "op_k_t_last2",
        "op_v_reshape",
        "op_v_transpose",
        "op_scores",
        "op_scale",
        "op_add_padding_mask",
        "op_softmax",
        "op_attn_dropout",
        "op_weighted_sum",
        "op_concat_prep",
        "op_concat",
        "op_out_proj",
        "op_out_dropout"
      ],
      "overall_formula": "\\mathrm{MHA}(X) = \\mathrm{Dropout}\\!\\left(\\left[\\mathrm{Concat}_{h}\\, \\mathrm{Attention}(XW_Q^h, XW_K^h, XW_V^h)\\right] W_O + b_O\\right)",
      "why_grouped": "These steps together implement the full multi-head self-attention sublayer output prior to residual Add & Norm."
    }
  ],
