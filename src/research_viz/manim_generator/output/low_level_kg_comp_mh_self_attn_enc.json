  "implementation_hints": [
    {
      "topic": "Fused QKV projection",
      "description": "Compute Q, K, V with a single linear layer and then split along the last dimension for better throughput.",
      "affected_operations": [
        "op_q_proj",
        "op_k_proj",
        "op_v_proj"
