{
  "component_id": "comp_mh_self_attn_enc",
  "component_name": "Encoder Multi-Head Self-Attention",
  "atomic_operations": [
    {
      "id": "op_q_proj",
      "name": "query_projection",
      "type": "linear",
      "description": "Projects encoder hidden states into the query subspace for all heads at once. Implements an affine transform along the last dimension.",
      "mathematical_formula": "Q = X W_Q + b_Q",
      "input_tensors": [
        {
          "name": "X",
          "shape": "[batch, seq_len, d_model]",
          "dtype": "float32",
          "description": "Encoder layer input (post positional embedding or previous block output)"
        }
      ],
      "output_tensors": [
        {
          "name": "Q",
          "shape": "[batch, seq_len, h*d_k]",
          "dtype": "float32",
          "description": "Concatenated per-head query vectors before head-splitting"
        }
      ],
      "parameters": [
        {
          "name": "W_Q",
          "shape": "[d_model, h*d_k]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Weights mapping model dimension to concatenated head query dimensions"
        },
        {
          "name": "b_Q",
          "shape": "[h*d_k]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Bias for query projection"
        }
      ],
      "hyperparameters": [
        {
          "name": "d_model",
          "value": "512",
          "description": "Model embedding dimension"
        },
        {
          "name": "h",
          "value": "8",
          "description": "Number of attention heads"
        },
        {
          "name": "d_k",
          "value": "64",
          "description": "Per-head query/key dimension"
        }
      ],
      "computational_complexity": "O(batch * seq_len * d_model * h*d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_proj",
      "name": "key_projection",
      "type": "linear",
      "description": "Projects encoder hidden states into the key subspace for all heads. Affine transform along the last dimension.",
      "mathematical_formula": "K = X W_K + b_K",
      "input_tensors": [
        {
          "name": "X",
          "shape": "[batch, seq_len, d_model]",
          "dtype": "float32",
          "description": "Same tensor as query input in self-attention"
        }
      ],
      "output_tensors": [
        {
          "name": "K",
          "shape": "[batch, seq_len, h*d_k]",
          "dtype": "float32",
          "description": "Concatenated per-head key vectors before head-splitting"
        }
      ],
      "parameters": [
        {
          "name": "W_K",
          "shape": "[d_model, h*d_k]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Weights mapping to concatenated key dimensions"
        },
        {
          "name": "b_K",
          "shape": "[h*d_k]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Bias for key projection"
        }
      ],
      "hyperparameters": [
        {
          "name": "h",
          "value": "8",
          "description": null
        },
        {
          "name": "d_k",
          "value": "64",
          "description": null
        }
      ],
      "computational_complexity": "O(batch * seq_len * d_model * h*d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_proj",
      "name": "value_projection",
      "type": "linear",
      "description": "Projects encoder hidden states into the value subspace for all heads. Affine transform along the last dimension.",
      "mathematical_formula": "V = X W_V + b_V",
      "input_tensors": [
        {
          "name": "X",
          "shape": "[batch, seq_len, d_model]",
          "dtype": "float32",
          "description": "Same tensor as query/key input in self-attention"
        }
      ],
      "output_tensors": [
        {
          "name": "V",
          "shape": "[batch, seq_len, h*d_v]",
          "dtype": "float32",
          "description": "Concatenated per-head value vectors before head-splitting"
        }
      ],
      "parameters": [
        {
          "name": "W_V",
          "shape": "[d_model, h*d_v]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Weights mapping to concatenated value dimensions"
        },
        {
          "name": "b_V",
          "shape": "[h*d_v]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Bias for value projection"
        }
      ],
      "hyperparameters": [
        {
          "name": "h",
          "value": "8",
          "description": null
        },
        {
          "name": "d_v",
          "value": "64",
          "description": "Per-head value dimension (paper uses d_v=d_k)"
        }
      ],
      "computational_complexity": "O(batch * seq_len * d_model * h*d_v)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_q_reshape",
      "name": "query_split_heads",
      "type": "reshape",
      "description": "Reshapes concatenated query dimension into (num_heads, d_k) per position, then prepares for batched attention.",
      "mathematical_formula": "Q' = \\text{reshape}(Q, [B, S, h, d_k])",
      "input_tensors": [
        {
          "name": "Q",
          "shape": "[batch, seq_len, h*d_k]",
          "dtype": "float32",
          "description": "Concatenated queries"
        }
      ],
      "output_tensors": [
        {
          "name": "Q_heads_seq_first",
          "shape": "[batch, seq_len, h, d_k]",
          "dtype": "float32",
          "description": "Queries split into heads"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "h",
          "value": "8",
          "description": "Number of heads"
        },
        {
          "name": "d_k",
          "value": "64",
          "description": null
        }
      ],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_q_transpose",
      "name": "query_heads_to_bhsd",
      "type": "reshape",
      "description": "Permutes dimensions to place heads before sequence for efficient batched matmul.",
      "mathematical_formula": "Q^{mh} = \\text{transpose}(Q', [0, 2, 1, 3])",
      "input_tensors": [
        {
          "name": "Q_heads_seq_first",
          "shape": "[batch, seq_len, h, d_k]",
          "dtype": "float32",
          "description": "Queries split into heads"
        }
      ],
      "output_tensors": [
        {
          "name": "Q_mh",
          "shape": "[batch, h, seq_len, d_k]",
          "dtype": "float32",
          "description": "Queries ready for multi-head attention matmul"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_reshape",
      "name": "key_split_heads",
      "type": "reshape",
      "description": "Reshapes concatenated key dimension into (num_heads, d_k) per position.",
      "mathematical_formula": "K' = \\text{reshape}(K, [B, S, h, d_k])",
      "input_tensors": [
        {
          "name": "K",
          "shape": "[batch, seq_len, h*d_k]",
          "dtype": "float32",
          "description": "Concatenated keys"
        }
      ],
      "output_tensors": [
        {
          "name": "K_heads_seq_first",
          "shape": "[batch, seq_len, h, d_k]",
          "dtype": "float32",
          "description": "Keys split into heads"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_transpose",
      "name": "key_heads_to_bhsd",
      "type": "reshape",
      "description": "Permutes dimensions to place heads before sequence for attention.",
      "mathematical_formula": "K^{mh} = \\text{transpose}(K', [0, 2, 1, 3])",
      "input_tensors": [
        {
          "name": "K_heads_seq_first",
          "shape": "[batch, seq_len, h, d_k]",
          "dtype": "float32",
          "description": "Keys split into heads"
        }
      ],
      "output_tensors": [
        {
          "name": "K_mh",
          "shape": "[batch, h, seq_len, d_k]",
          "dtype": "float32",
          "description": "Keys ready for multi-head attention matmul"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_t_last2",
      "name": "key_last_dim_transpose",
      "type": "reshape",
      "description": "Swaps the last two dimensions to obtain K^T for batched dot products within each head.",
      "mathematical_formula": "K^{T} = \\text{transpose}(K^{mh}, [0,1,3,2])",
      "input_tensors": [
        {
          "name": "K_mh",
          "shape": "[batch, h, seq_len, d_k]",
          "dtype": "float32",
          "description": "Keys with head-first layout"
        }
      ],
      "output_tensors": [
        {
          "name": "K_mh_T",
          "shape": "[batch, h, d_k, seq_len]",
          "dtype": "float32",
          "description": "Per-head key matrices transposed for dot product"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_reshape",
      "name": "value_split_heads",
      "type": "reshape",
      "description": "Reshapes concatenated value dimension into (num_heads, d_v) per position.",
      "mathematical_formula": "V' = \\text{reshape}(V, [B, S, h, d_v])",
      "input_tensors": [
        {
          "name": "V",
          "shape": "[batch, seq_len, h*d_v]",
          "dtype": "float32",
          "description": "Concatenated values"
        }
      ],
      "output_tensors": [
        {
          "name": "V_heads_seq_first",
          "shape": "[batch, seq_len, h, d_v]",
          "dtype": "float32",
          "description": "Values split into heads"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "d_v",
          "value": "64",
          "description": null
        }
      ],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_transpose",
      "name": "value_heads_to_bhsd",
      "type": "reshape",
      "description": "Permutes dimensions to place heads before sequence for attention aggregation.",
      "mathematical_formula": "V^{mh} = \\text{transpose}(V', [0, 2, 1, 3])",
      "input_tensors": [
        {
          "name": "V_heads_seq_first",
          "shape": "[batch, seq_len, h, d_v]",
          "dtype": "float32",
          "description": "Values split into heads"
        }
      ],
      "output_tensors": [
        {
          "name": "V_mh",
          "shape": "[batch, h, seq_len, d_v]",
          "dtype": "float32",
          "description": "Values ready for weighted sum"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_scores",
      "name": "attention_scores_matmul",
      "type": "matmul",
      "description": "Computes raw compatibility scores for each head by dot product between queries and keys. Produces an SxS score matrix per head.",
      "mathematical_formula": "S = Q^{mh} \\times K^{T}",
      "input_tensors": [
        {
          "name": "Q_mh",
          "shape": "[batch, h, seq_len, d_k]",
          "dtype": "float32",
          "description": "Per-head queries"
        },
        {
          "name": "K_mh_T",
          "shape": "[batch, h, d_k, seq_len]",
          "dtype": "float32",
          "description": "Per-head keys transposed"
        }
      ],
      "output_tensors": [
        {
          "name": "scores",
          "shape": "[batch, h, seq_len, seq_len]",
          "dtype": "float32",
          "description": "Raw attention scores"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * seq_len^2 * d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_scale",
      "name": "scale_scores",
      "type": "elementwise",
      "description": "Scales the dot-product scores by 1/sqrt(d_k) to keep values in a range that avoids softmax saturation.",
      "mathematical_formula": "S_{scaled} = \\frac{S}{\\sqrt{d_k}}",
      "input_tensors": [
        {
          "name": "scores",
          "shape": "[batch, h, seq_len, seq_len]",
          "dtype": "float32",
          "description": "Raw attention scores"
        }
      ],
      "output_tensors": [
        {
          "name": "scores_scaled",
          "shape": "[batch, h, seq_len, seq_len]",
          "dtype": "float32",
          "description": "Scaled attention scores"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "d_k",
          "value": "64",
          "description": "Scaling denominator"
        }
      ],
      "computational_complexity": "O(batch * h * seq_len^2)",
      "numerical_stability_notes": "Scaling mitigates large magnitude dot products which can cause vanishing gradients after softmax."
    },
    {
      "id": "op_add_padding_mask",
      "name": "apply_padding_mask",
      "type": "elementwise",
      "description": "Adds a large negative bias to positions corresponding to padding tokens so they receive near-zero probability after softmax.",
      "mathematical_formula": "S_{masked} = S_{scaled} + M_{pad}",
      "input_tensors": [
        {
          "name": "scores_scaled",
          "shape": "[batch, h, seq_len, seq_len]",
          "dtype": "float32",
          "description": "Scaled attention scores"
        },
        {
          "name": "M_pad",
          "shape": "[batch, 1, 1, seq_len]",
          "dtype": "float32",
          "description": "Additive mask with 0 for valid and -\\infty (or large negative) for padded positions; broadcast across heads and query positions"
        }
      ],
      "output_tensors": [
        {
          "name": "scores_masked",
          "shape": "[batch, h, seq_len, seq_len]",
          "dtype": "float32",
          "description": "Masked attention scores"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * seq_len^2)",
      "numerical_stability_notes": "Use a large negative constant like -1e9 when -inf is not supported; ensure mask is added before softmax."
    },
    {
      "id": "op_softmax",
      "name": "attention_softmax",
      "type": "activation",
      "description": "Normalizes masked scores row-wise over key positions to obtain attention weights.",
      "mathematical_formula": "A = \\text{softmax}(S_{masked}, \\text{dim}=-1) = \\frac{\\exp(S_{masked} - \\max_{j} S_{masked})}{\\sum_{j} \\exp(S_{masked} - \\max_{j} S_{masked})}",
      "input_tensors": [
        {
          "name": "scores_masked",
          "shape": "[batch, h, seq_len, seq_len]",
          "dtype": "float32",
          "description": "Masked attention logits"
        }
      ],
      "output_tensors": [
        {
          "name": "attn_weights",
          "shape": "[batch, h, seq_len, seq_len]",
          "dtype": "float32",
          "description": "Attention probability distributions"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * seq_len^2)",
      "numerical_stability_notes": "Subtract per-row max before exponentiation; consider upcasting to float32 when using mixed precision."
    },
    {
      "id": "op_attn_dropout",
      "name": "attention_dropout",
      "type": "dropout",
      "description": "Applies dropout to attention weights for regularization during training. Scales surviving weights by 1/(1-p).",
      "mathematical_formula": "A' = \\text{Dropout}(A, p_{attn})",
      "input_tensors": [
        {
          "name": "attn_weights",
          "shape": "[batch, h, seq_len, seq_len]",
          "dtype": "float32",
          "description": "Normalized attention weights"
        }
      ],
      "output_tensors": [
        {
          "name": "attn_weights_do",
          "shape": "[batch, h, seq_len, seq_len]",
          "dtype": "float32",
          "description": "Attention weights after dropout"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "dropout_attn",
          "value": "0.1",
          "description": "Dropout probability on attention weights"
        }
      ],
      "computational_complexity": "O(batch * h * seq_len^2)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_weighted_sum",
      "name": "weighted_value_sum",
      "type": "matmul",
      "description": "Computes the context vectors as the attention-weighted sum of value vectors per head.",
      "mathematical_formula": "C^{mh} = A' \\times V^{mh}",
      "input_tensors": [
        {
          "name": "attn_weights_do",
          "shape": "[batch, h, seq_len, seq_len]",
          "dtype": "float32",
          "description": "Attention weights"
        },
        {
          "name": "V_mh",
          "shape": "[batch, h, seq_len, d_v]",
          "dtype": "float32",
          "description": "Per-head values"
        }
      ],
      "output_tensors": [
        {
          "name": "context_mh",
          "shape": "[batch, h, seq_len, d_v]",
          "dtype": "float32",
          "description": "Per-head attention outputs"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * seq_len^2 * d_v)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_concat_prep",
      "name": "context_transpose_to_bshd",
      "type": "reshape",
      "description": "Permutes per-head outputs to put sequence length before heads for concatenation.",
      "mathematical_formula": "C' = \\text{transpose}(C^{mh}, [0, 2, 1, 3])",
      "input_tensors": [
        {
          "name": "context_mh",
          "shape": "[batch, h, seq_len, d_v]",
          "dtype": "float32",
          "description": "Per-head outputs"
        }
      ],
      "output_tensors": [
        {
          "name": "context_bshd",
          "shape": "[batch, seq_len, h, d_v]",
          "dtype": "float32",
          "description": "Per-position head outputs"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_concat",
      "name": "concatenate_heads",
      "type": "reshape",
      "description": "Flattens the head and per-head channel dimensions back into model dimension.",
      "mathematical_formula": "C = \\text{reshape}(C', [B, S, h*d_v])",
      "input_tensors": [
        {
          "name": "context_bshd",
          "shape": "[batch, seq_len, h, d_v]",
          "dtype": "float32",
          "description": "Per-position head outputs"
        }
      ],
      "output_tensors": [
        {
          "name": "context_concat",
          "shape": "[batch, seq_len, h*d_v]",
          "dtype": "float32",
          "description": "Concatenated head outputs"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "h",
          "value": "8",
          "description": null
        },
        {
          "name": "d_v",
          "value": "64",
          "description": null
        }
      ],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_out_proj",
      "name": "output_projection",
      "type": "linear",
      "description": "Projects concatenated head outputs back to model dimension to mix information across heads.",
      "mathematical_formula": "Y = C W_O + b_O",
      "input_tensors": [
        {
          "name": "context_concat",
          "shape": "[batch, seq_len, h*d_v]",
          "dtype": "float32",
          "description": "Concatenated multi-head outputs"
        }
      ],
      "output_tensors": [
        {
          "name": "attn_out",
          "shape": "[batch, seq_len, d_model]",
          "dtype": "float32",
          "description": "Multi-head attention output in model dimension"
        }
      ],
      "parameters": [
        {
          "name": "W_O",
          "shape": "[h*d_v, d_model]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Output projection weights"
        },
        {
          "name": "b_O",
          "shape": "[d_model]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Output projection bias"
        }
      ],
      "hyperparameters": [
        {
          "name": "d_model",
          "value": "512",
          "description": null
        }
      ],
      "computational_complexity": "O(batch * seq_len * d_model * h*d_v)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_out_dropout",
      "name": "output_dropout",
      "type": "dropout",
      "description": "Applies dropout to the projected attention output before residual connection as used in the Transformer.",
      "mathematical_formula": "Y' = \\text{Dropout}(Y, p_{out})",
      "input_tensors": [
        {
          "name": "attn_out",
          "shape": "[batch, seq_len, d_model]",
          "dtype": "float32",
          "description": "Projected attention output"
        }
      ],
      "output_tensors": [
        {
          "name": "attn_out_do",
          "shape": "[batch, seq_len, d_model]",
          "dtype": "float32",
          "description": "Attention output after dropout (to be used in residual Add & Norm outside this component)"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "dropout_out",
          "value": "0.1",
          "description": "Dropout probability on attention output"
        }
      ],
      "computational_complexity": "O(batch * seq_len * d_model)",
      "numerical_stability_notes": null
    }
  ],
  "data_flow": [
    {
      "step": 1,
      "operation_id": "op_q_proj",
      "input_from": [
        "component_input"
      ],
      "output_to": [
        "op_q_reshape"
      ],
      "intermediate_result": "Query vectors in concatenated head space",
      "tensor_shape_at_step": "[batch, seq_len, h*d_k]",
      "notes": "X is reused for keys and values"
    },
    {
      "step": 2,
      "operation_id": "op_k_proj",
      "input_from": [
        "component_input"
      ],
      "output_to": [
        "op_k_reshape"
      ],
      "intermediate_result": "Key vectors in concatenated head space",
      "tensor_shape_at_step": "[batch, seq_len, h*d_k]",
      "notes": null
    },
    {
      "step": 3,
      "operation_id": "op_v_proj",
      "input_from": [
        "component_input"
      ],
      "output_to": [
        "op_v_reshape"
      ],
      "intermediate_result": "Value vectors in concatenated head space",
      "tensor_shape_at_step": "[batch, seq_len, h*d_v]",
      "notes": null
    },
    {
      "step": 4,
      "operation_id": "op_q_reshape",
      "input_from": [
        "op_q_proj"
      ],
      "output_to": [
        "op_q_transpose"
