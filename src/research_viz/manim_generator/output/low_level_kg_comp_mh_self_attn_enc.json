      "code_snippet": "M_pad = (~key_padding_mask).unsqueeze(1).unsqueeze(2).to(x.dtype) * 0 + key_padding_mask.unsqueeze(1).unsqueeze(2).to(x.dtype) * (-1e9)"
    },
    {
      "topic": "Contiguity before view",
      "description": "Call contiguous() after permute and before view to avoid runtime errors when flattening head dimensions.",
      "affected_operations": [
        "op_concat"
      ],
      "code_snippet": "context = context_mh.permute(0,2,1,3).contiguous().view(B, S, h*d_v)"
    },
    {
      "topic": "Gradient scaling and clipping",
      "description": "When training with long sequences, gradients through attention may be large; clip global norm to stabilize training.",
