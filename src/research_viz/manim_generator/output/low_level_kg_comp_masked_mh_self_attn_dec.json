{
  "component_id": "comp_masked_mh_self_attn_dec",
  "component_name": "Decoder Masked Multi-Head Self-Attention",
  "atomic_operations": [
    {
      "id": "op_q_matmul",
      "name": "query_linear_matmul",
      "type": "matmul",
      "description": "Matrix multiply to project decoder hidden states into the query subspace. This computes the un-biased linear transformation for queries.",
      "mathematical_formula": "\\tilde{Q} = X W_Q",
      "input_tensors": [
        {
          "name": "X",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Decoder hidden states (shifted-right embeddings or previous layer output)"
        }
      ],
      "output_tensors": [
        {
          "name": "Q_lin",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Query linear output before bias"
        }
      ],
      "parameters": [
        {
          "name": "W_Q",
          "shape": "[d_model, d_model]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Query projection weight"
        }
      ],
      "hyperparameters": [
        {
          "name": "d_model",
          "value": "512",
          "description": "Model dimensionality"
        }
      ],
      "computational_complexity": "O(batch * tgt_len * d_model^2)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_q_bias",
      "name": "query_bias_add",
      "type": "elementwise",
      "description": "Adds a learnable bias to the query linear output. Broadcasts bias over batch and sequence dimensions.",
      "mathematical_formula": "Q = \\tilde{Q} + b_Q",
      "input_tensors": [
        {
          "name": "Q_lin",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Unbiased query projections"
        }
      ],
      "output_tensors": [
        {
          "name": "Q",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Biased query projections"
        }
      ],
      "parameters": [
        {
          "name": "b_Q",
          "shape": "[d_model]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Query projection bias"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * tgt_len * d_model)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_matmul",
      "name": "key_linear_matmul",
      "type": "matmul",
      "description": "Projects decoder hidden states into the key subspace via a linear transformation (without bias).",
      "mathematical_formula": "\\tilde{K} = X W_K",
      "input_tensors": [
        {
          "name": "X",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Decoder hidden states"
        }
      ],
      "output_tensors": [
        {
          "name": "K_lin",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Key linear output before bias"
        }
      ],
      "parameters": [
        {
          "name": "W_K",
          "shape": "[d_model, d_model]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Key projection weight"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * tgt_len * d_model^2)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_bias",
      "name": "key_bias_add",
      "type": "elementwise",
      "description": "Adds a learnable bias to key linear outputs.",
      "mathematical_formula": "K = \\tilde{K} + b_K",
      "input_tensors": [
        {
          "name": "K_lin",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Unbiased key projections"
        }
      ],
      "output_tensors": [
        {
          "name": "K",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Biased key projections"
        }
      ],
      "parameters": [
        {
          "name": "b_K",
          "shape": "[d_model]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Key projection bias"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * tgt_len * d_model)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_matmul",
      "name": "value_linear_matmul",
      "type": "matmul",
      "description": "Projects decoder hidden states into the value subspace via linear transformation (without bias).",
      "mathematical_formula": "\\tilde{V} = X W_V",
      "input_tensors": [
        {
          "name": "X",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Decoder hidden states"
        }
      ],
      "output_tensors": [
        {
          "name": "V_lin",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Value linear output before bias"
        }
      ],
      "parameters": [
        {
          "name": "W_V",
          "shape": "[d_model, d_model]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Value projection weight"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * tgt_len * d_model^2)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_bias",
      "name": "value_bias_add",
      "type": "elementwise",
      "description": "Adds a learnable bias to value linear outputs.",
      "mathematical_formula": "V = \\tilde{V} + b_V",
      "input_tensors": [
        {
          "name": "V_lin",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Unbiased value projections"
        }
      ],
      "output_tensors": [
        {
          "name": "V",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Biased value projections"
        }
      ],
      "parameters": [
        {
          "name": "b_V",
          "shape": "[d_model]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Value projection bias"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * tgt_len * d_model)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_q_reshape",
      "name": "query_split_heads_reshape",
      "type": "reshape",
      "description": "Reshapes queries to split the model dimension into multiple heads. No data copy in ideal implementations.",
      "mathematical_formula": "Q_r = \\text{reshape}(Q, [B, S, H, d_k])",
      "input_tensors": [
        {
          "name": "Q",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Query projections"
        }
      ],
      "output_tensors": [
        {
          "name": "Q_r",
          "shape": "[batch, tgt_len, num_heads, d_k]",
          "dtype": "float32",
          "description": "Queries with head dimension explicit"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "num_heads",
          "value": "8",
          "description": "Number of attention heads"
        },
        {
          "name": "d_k",
          "value": "d_model / num_heads",
          "description": "Per-head query/key size"
        }
      ],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_q_transpose",
      "name": "query_heads_bring_forward",
      "type": "reshape",
      "description": "Permutes dimensions to place heads before sequence length for batched attention matmul.",
      "mathematical_formula": "Q_h = \\text{transpose}(Q_r, [0, 2, 1, 3])",
      "input_tensors": [
        {
          "name": "Q_r",
          "shape": "[batch, tgt_len, num_heads, d_k]",
          "dtype": "float32",
          "description": "Reshaped queries"
        }
      ],
      "output_tensors": [
        {
          "name": "Q_h",
          "shape": "[batch, num_heads, tgt_len, d_k]",
          "dtype": "float32",
          "description": "Queries prepared for attention"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_reshape",
      "name": "key_split_heads_reshape",
      "type": "reshape",
      "description": "Reshapes keys to split the model dimension into heads. Mirrors query reshape.",
      "mathematical_formula": "K_r = \\text{reshape}(K, [B, S, H, d_k])",
      "input_tensors": [
        {
          "name": "K",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Key projections"
        }
      ],
      "output_tensors": [
        {
          "name": "K_r",
          "shape": "[batch, tgt_len, num_heads, d_k]",
          "dtype": "float32",
          "description": "Keys with head dimension explicit"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "num_heads",
          "value": "8",
          "description": "Number of heads"
        },
        {
          "name": "d_k",
          "value": "d_model / num_heads",
          "description": "Per-head size"
        }
      ],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_transpose",
      "name": "key_heads_bring_forward",
      "type": "reshape",
      "description": "Permutes key tensor dimensions to process attention per head.",
      "mathematical_formula": "K_h = \\text{transpose}(K_r, [0, 2, 1, 3])",
      "input_tensors": [
        {
          "name": "K_r",
          "shape": "[batch, tgt_len, num_heads, d_k]",
          "dtype": "float32",
          "description": "Reshaped keys"
        }
      ],
      "output_tensors": [
        {
          "name": "K_h",
          "shape": "[batch, num_heads, tgt_len, d_k]",
          "dtype": "float32",
          "description": "Keys prepared for attention"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_reshape",
      "name": "value_split_heads_reshape",
      "type": "reshape",
      "description": "Reshapes values to split model dimension into heads with per-head size d_v (usually equals d_k).",
      "mathematical_formula": "V_r = \\text{reshape}(V, [B, S, H, d_v])",
      "input_tensors": [
        {
          "name": "V",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Value projections"
        }
      ],
      "output_tensors": [
        {
          "name": "V_r",
          "shape": "[batch, tgt_len, num_heads, d_v]",
          "dtype": "float32",
          "description": "Values with head dimension explicit"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "num_heads",
          "value": "8",
          "description": "Number of heads"
        },
        {
          "name": "d_v",
          "value": "d_model / num_heads",
          "description": "Per-head value size"
        }
      ],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_transpose",
      "name": "value_heads_bring_forward",
      "type": "reshape",
      "description": "Permutes value tensor to head-first layout for batched attention.",
      "mathematical_formula": "V_h = \\text{transpose}(V_r, [0, 2, 1, 3])",
      "input_tensors": [
        {
          "name": "V_r",
          "shape": "[batch, tgt_len, num_heads, d_v]",
          "dtype": "float32",
          "description": "Reshaped values"
        }
      ],
      "output_tensors": [
        {
          "name": "V_h",
          "shape": "[batch, num_heads, tgt_len, d_v]",
          "dtype": "float32",
          "description": "Values prepared for attention"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_scores_matmul",
      "name": "attention_scores_matmul",
      "type": "matmul",
      "description": "Computes raw attention scores for each head by multiplying queries with transposed keys. This yields pairwise compatibilities between all target positions.",
      "mathematical_formula": "S = Q_h \\cdot K_h^\\top",
      "input_tensors": [
        {
          "name": "Q_h",
          "shape": "[batch, num_heads, tgt_len, d_k]",
          "dtype": "float32",
          "description": "Per-head queries"
        },
        {
          "name": "K_h",
          "shape": "[batch, num_heads, tgt_len, d_k]",
          "dtype": "float32",
          "description": "Per-head keys"
        }
      ],
      "output_tensors": [
        {
          "name": "S",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Raw attention score matrix"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * tgt_len^2 * d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_scale_scores",
      "name": "scale_attention_scores",
      "type": "elementwise",
      "description": "Scales the raw attention scores by the inverse square root of head dimension to avoid softmax saturation.",
      "mathematical_formula": "S_{scaled} = \\frac{S}{\\sqrt{d_k}}",
      "input_tensors": [
        {
          "name": "S",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Raw attention scores"
        }
      ],
      "output_tensors": [
        {
          "name": "S_scaled",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Scaled attention scores"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "d_k",
          "value": "d_model / num_heads",
          "description": "Scaling dimension"
        }
      ],
      "computational_complexity": "O(batch * num_heads * tgt_len^2)",
      "numerical_stability_notes": "Scaling helps keep softmax in sensitive gradient regime."
    },
    {
      "id": "op_build_causal_mask",
      "name": "build_strict_upper_triangular_causal_mask",
      "type": "elementwise",
      "description": "Constructs a boolean upper-triangular mask that forbids attending to future positions (j > i). True indicates masked/illegal connections.",
      "mathematical_formula": "M_{causal}[i,j] = \\begin{cases} 1 & j > i \\\\ 0 & \\text{otherwise} \\end{cases}",
      "input_tensors": [
        {
          "name": "tgt_len",
          "shape": "[]",
          "dtype": "int64",
          "description": "Target sequence length"
        }
      ],
      "output_tensors": [
        {
          "name": "M_causal",
          "shape": "[tgt_len, tgt_len]",
          "dtype": "bool",
          "description": "Causal mask matrix (upper triangular)"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(tgt_len^2)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_expand_causal_mask",
      "name": "broadcast_causal_mask_to_batch_heads",
      "type": "reshape",
      "description": "Expands the 2D causal mask to align with batch and head dimensions for addition with scores.",
      "mathematical_formula": "M^{(B,H)}_{causal} = \\text{broadcast}(M_{causal}, [B, H, S, S])",
      "input_tensors": [
        {
          "name": "M_causal",
          "shape": "[tgt_len, tgt_len]",
          "dtype": "bool",
          "description": "2D causal mask"
        }
      ],
      "output_tensors": [
        {
          "name": "M_causal_bh",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "bool",
          "description": "Causal mask broadcast over batch and heads"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_apply_causal_mask",
      "name": "apply_causal_mask_additive",
      "type": "elementwise",
      "description": "Applies the causal mask by setting masked positions to a very large negative value before softmax using additive masking.",
      "mathematical_formula": "S_{mask1} = S_{scaled} + (\\mathbb{1}_{M_{causal\\_bh}}) \\cdot (-\\infty)",
      "input_tensors": [
        {
          "name": "S_scaled",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Scaled attention scores"
        },
        {
          "name": "M_causal_bh",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "bool",
          "description": "Broadcast causal mask"
        }
      ],
      "output_tensors": [
        {
          "name": "S_mask1",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Scores after causal masking"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * tgt_len^2)",
      "numerical_stability_notes": "Use a finite large negative constant (e.g., -1e9) to avoid NaNs in half precision."
    },
    {
      "id": "op_apply_padding_mask",
      "name": "apply_key_padding_mask_additive",
      "type": "elementwise",
      "description": "Optionally masks padded key positions so they receive zero attention probability. The key padding mask is broadcast across query positions and heads.",
      "mathematical_formula": "S_{masked} = S_{mask1} + (\\mathbb{1}_{M_{pad}}) \\cdot (-\\infty)",
      "input_tensors": [
        {
          "name": "S_mask1",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Scores after causal mask"
        },
        {
          "name": "key_padding_mask",
          "shape": "[batch, tgt_len]",
          "dtype": "bool",
          "description": "True for padded/invalid key positions; optional"
        }
      ],
      "output_tensors": [
        {
          "name": "S_masked",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Scores after causal + padding masking"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * tgt_len^2)",
      "numerical_stability_notes": "Broadcast padding mask to [B,1,1,S] before addition to exploit broadcasting."
    },
    {
      "id": "op_softmax",
      "name": "masked_attention_softmax",
      "type": "activation",
      "description": "Applies softmax over the last dimension (keys) to convert masked scores into attention weights. Implements the max-subtraction trick for stability.",
      "mathematical_formula": "A = \\text{softmax}(S_{masked}) = \\frac{\\exp(S_{masked} - \\max_j S_{masked})}{\\sum_j \\exp(S_{masked} - \\max_j S_{masked})}",
      "input_tensors": [
        {
          "name": "S_masked",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Masked attention scores"
        }
      ],
      "output_tensors": [
        {
          "name": "A",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Attention weights (rows sum to 1)"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * tgt_len^2)",
      "numerical_stability_notes": "Subtract row-wise max before exponentiation; compute in float32 even under mixed precision."
    },
    {
      "id": "op_attn_dropout",
      "name": "attention_weights_dropout",
      "type": "dropout",
      "description": "Applies dropout to the attention weights for regularization during training. Scales surviving weights by 1/(1-p).",
      "mathematical_formula": "A' = \\text{Dropout}(A, p_{attn})",
      "input_tensors": [
        {
          "name": "A",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Attention weights"
        }
      ],
      "output_tensors": [
        {
          "name": "A_do",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Attention weights after dropout"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "attn_dropout",
          "value": "0.1",
          "description": "Dropout rate on attention weights"
        }
      ],
      "computational_complexity": "O(batch * num_heads * tgt_len^2)",
      "numerical_stability_notes": "Disabled during inference."
    },
    {
      "id": "op_weighted_sum",
      "name": "attention_weighted_sum_values",
      "type": "matmul",
      "description": "Computes per-head context vectors as the weighted sum of value vectors using the (dropout-perturbed) attention weights.",
      "mathematical_formula": "C_h = A' \\cdot V_h",
      "input_tensors": [
        {
          "name": "A_do",
          "shape": "[batch, num_heads, tgt_len, tgt_len]",
          "dtype": "float32",
          "description": "Attention weights after dropout"
        },
        {
          "name": "V_h",
          "shape": "[batch, num_heads, tgt_len, d_v]",
          "dtype": "float32",
          "description": "Per-head values"
        }
      ],
      "output_tensors": [
        {
          "name": "C_h",
          "shape": "[batch, num_heads, tgt_len, d_v]",
          "dtype": "float32",
          "description": "Per-head context vectors"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * num_heads * tgt_len^2 * d_v)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_context_transpose",
      "name": "context_heads_move_after_seq",
      "type": "reshape",
      "description": "Transposes the context tensor to sequence-major format to prepare for concatenation across heads.",
      "mathematical_formula": "C_t = \\text{transpose}(C_h, [0, 2, 1, 3])",
      "input_tensors": [
        {
          "name": "C_h",
          "shape": "[batch, num_heads, tgt_len, d_v]",
          "dtype": "float32",
          "description": "Per-head context vectors"
        }
      ],
      "output_tensors": [
        {
          "name": "C_t",
          "shape": "[batch, tgt_len, num_heads, d_v]",
          "dtype": "float32",
          "description": "Context transposed for concatenation"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_context_reshape",
      "name": "concatenate_heads_reshape",
      "type": "reshape",
      "description": "Concatenates heads by reshaping the last two dimensions into a single model dimension.",
      "mathematical_formula": "C = \\text{reshape}(C_t, [B, S, H \\cdot d_v])",
      "input_tensors": [
