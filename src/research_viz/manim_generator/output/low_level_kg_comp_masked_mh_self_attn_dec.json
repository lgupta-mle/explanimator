  "implementation_hints": [
    {
      "topic": "Masking",
      "description": "Combine causal and padding masks via broadcasting to avoid materializing multiple [B,H,S,S] tensors. Use additive mask with large negative constant.",
      "affected_operations": [
        "op_expand_causal_mask",
        "op_apply_causal_mask",
        "op_apply_padding_mask"
      ],
      "code_snippet": "mask = torch.triu(torch.ones(S, S, dtype=torch.bool), diagonal=1)  # [S,S]\nmask = mask.to(X.device)\n# broadcast: [1,1,S,S]\nmask = mask.view(1,1,S,S)\nif key_padding_mask is not None:  # [B,S]\n    pad = key_padding_mask.view(B,1,1,S)  # broadcast over heads & queries\n    combined = mask | pad\nelse:\n    combined = mask.expand(B, H, S, S)\nS_masked = S_scaled.masked_fill(combined, float('-inf'))"
    },
    {
      "topic": "Efficiency (fused kernels)",
      "description": "Use PyTorch 2.x scaled_dot_product_attention or FlashAttention for better speed and memory with masking and dropout fused.",
      "affected_operations": [
        "op_scores_matmul",
        "op_scale_scores",
        "op_apply_causal_mask",
        "op_apply_padding_mask",
        "op_softmax",
        "op_attn_dropout",
        "op_weighted_sum"
      ],
      "code_snippet": "out = torch.nn.functional.scaled_dot_product_attention(Q_h, K_h, V_h, attn_mask=None, dropout_p=attn_dropout, is_causal=True)\n# out: [B,H,S,d_v]"
    },
    {
      "topic": "Projection fusion",
      "description": "Fuse Q,K,V projections into a single matmul to reduce memory reads/writes.",
      "affected_operations": [
        "op_q_matmul",
        "op_q_bias",
        "op_k_matmul",
        "op_k_bias",
        "op_v_matmul",
        "op_v_bias"
      ],
      "code_snippet": "W_qkv = torch.nn.Parameter(torch.empty(d_model, 3*d_model))\nb_qkv = torch.nn.Parameter(torch.zeros(3*d_model))\nQKV = X @ W_qkv + b_qkv  # [B,S,3*D]\nQ, K, V = QKV.chunk(3, dim=-1)"
    },
    {
      "topic": "Contiguity and reshaping",
      "description": "After transposes, ensure .contiguous() before .view to avoid runtime errors.",
      "affected_operations": [
        "op_context_reshape",
        "op_q_reshape",
        "op_k_reshape",
        "op_v_reshape"
      ],
      "code_snippet": "C = C_h.transpose(1,2).contiguous().view(B, S, D)"
