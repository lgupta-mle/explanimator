  "composite_operations": [
    {
      "id": "comp_qkv_projection",
      "name": "QKV Projection (per-token linear projections)",
      "description": "Parallel linear mappings from decoder hidden states into query, key, and value spaces with separate weights and biases.",
      "atomic_operations_involved": [
        "op_q_matmul",
        "op_q_bias",
        "op_k_matmul",
        "op_k_bias",
        "op_v_matmul",
        "op_v_bias"
      ],
      "overall_formula": "Q = X W_Q + b_Q,\\quad K = X W_K + b_K,\\quad V = X W_V + b_V",
      "why_grouped": "These projections are always computed together and can be fused for efficiency."
    },
    {
      "id": "comp_split_heads",
      "name": "Split into Multi-Heads",
      "description": "Reshape and permute Q, K, V to expose the head dimension and prepare for batched attention computation.",
      "atomic_operations_involved": [
        "op_q_reshape",
        "op_q_transpose",
        "op_k_reshape",
        "op_k_transpose",
        "op_v_reshape",
        "op_v_transpose"
      ],
      "overall_formula": "T_h = \\text{transpose}(\\text{reshape}(T, [B,S,H,d_h]), [0,2,1,3])\\ \\text{for}\\ T\\in\\{Q,K,V\\}",
      "why_grouped": "Always performed as a unit before attention."
    },
    {
      "id": "comp_causal_scaled_dotprod",
      "name": "Causal Scaled Dot-Product Attention",
      "description": "Computes attention scores, applies scaling and causal/padding masks, normalizes with softmax, and aggregates values.",
      "atomic_operations_involved": [
        "op_scores_matmul",
        "op_scale_scores",
        "op_build_causal_mask",
        "op_expand_causal_mask",
        "op_apply_causal_mask",
        "op_apply_padding_mask",
        "op_softmax",
        "op_attn_dropout",
        "op_weighted_sum"
      ],
      "overall_formula": "C_h = \\text{softmax}\\!\\left(\\frac{Q_h K_h^T}{\\sqrt{d_k}} + M_{causal} + M_{pad}\\right) V_h",
      "why_grouped": "This is the core attention mechanism executed atomically in many optimized kernels."
    },
    {
      "id": "comp_merge_and_project",
      "name": "Merge Heads and Output Projection",
      "description": "Recombine per-head contexts into a single representation and linearly project back to model dimension, followed by dropout.",
      "atomic_operations_involved": [
        "op_context_transpose",
        "op_context_reshape",
        "op_out_matmul",
        "op_out_bias",
        "op_output_dropout"
      ],
      "overall_formula": "O' = \\text{Dropout}\\big( (\\text{concat}_{h=1}^H C_h) W_O + b_O,\\ p_{res} \\big)",
      "why_grouped": "These steps form the standard tail of multi-head attention."
    }
  ],
