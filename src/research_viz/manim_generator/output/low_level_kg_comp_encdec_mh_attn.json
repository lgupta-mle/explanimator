        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_transpose",
      "name": "value_transpose_bhsd",
      "type": "reshape",
      "description": "Permutes dimensions to [batch, heads, src_len, d_v] for batched attention.",
      "mathematical_formula": "V = \\text{transpose}(V', [0, 2, 1, 3])",
      "input_tensors": [
        {
          "name": "V_split",
          "shape": "[batch, src_len, h, d_v]",
          "dtype": "float32",
          "description": "Values split into heads"
        }
      ],
      "output_tensors": [
        {
          "name": "V",
          "shape": "[batch, h, src_len, d_v]",
          "dtype": "float32",
          "description": "Values ready for attention"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_scores_matmul",
      "name": "attention_scores_matmul",
      "type": "matmul",
      "description": "Computes raw attention scores by batched matrix multiplication of queries with transposed keys per head.",
      "mathematical_formula": "S = Q K^T",
      "input_tensors": [
        {
          "name": "Q",
          "shape": "[batch, h, tgt_len, d_k]",
          "dtype": "float32",
          "description": "Per-head queries"
        },
        {
          "name": "K",
          "shape": "[batch, h, src_len, d_k]",
          "dtype": "float32",
          "description": "Per-head keys"
        }
      ],
      "output_tensors": [
        {
          "name": "S",
          "shape": "[batch, h, tgt_len, src_len]",
          "dtype": "float32",
          "description": "Raw attention scores"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * tgt_len * src_len * d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_scale_scores",
      "name": "scale_scores_by_sqrt_dk",
      "type": "elementwise",
      "description": "Scales the raw scores by 1/sqrt(d_k) to keep softmax in a sensitive region and improve gradient flow.",
      "mathematical_formula": "S_{scaled} = S / \\sqrt{d_k}",
      "input_tensors": [
        {
          "name": "S",
          "shape": "[batch, h, tgt_len, src_len]",
          "dtype": "float32",
          "description": "Raw attention scores"
        }
      ],
      "output_tensors": [
        {
          "name": "S_scaled",
          "shape": "[batch, h, tgt_len, src_len]",
          "dtype": "float32",
          "description": "Scaled attention scores"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "d_k",
          "value": "64",
          "description": "Scaling denominator"
        }
      ],
      "computational_complexity": "O(batch * h * tgt_len * src_len)",
      "numerical_stability_notes": "Scaling mitigates softmax saturation."
    },
    {
      "id": "op_apply_padding_mask",
      "name": "apply_key_padding_mask",
      "type": "elementwise",
      "description": "Applies an additive mask to prevent attending to encoder padding positions by adding -inf to those columns before softmax. Broadcasts mask across heads and target positions.",
      "mathematical_formula": "S_{masked} = S_{scaled} + M_{pad}\\cdot(-\\infty)",
      "input_tensors": [
        {
          "name": "S_scaled",
          "shape": "[batch, h, tgt_len, src_len]",
          "dtype": "float32",
          "description": "Scaled attention scores"
        },
        {
          "name": "M_pad",
          "shape": "[batch, 1, 1, src_len]",
          "dtype": "bool",
          "description": "True where source positions are padding"
        }
      ],
      "output_tensors": [
        {
          "name": "S_masked",
          "shape": "[batch, h, tgt_len, src_len]",
          "dtype": "float32",
          "description": "Scores with -inf on masked source positions"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * tgt_len * src_len)",
      "numerical_stability_notes": "Use a large negative float (e.g., -1e9) instead of -inf in low-precision kernels."
    },
    {
      "id": "op_softmax",
      "name": "softmax_over_src",
      "type": "activation",
      "description": "Converts masked scores into attention probabilities by applying softmax over the source-time dimension.",
      "mathematical_formula": "A = \\text{softmax}(S_{masked}, \\text{dim}=-1)",
      "input_tensors": [
        {
          "name": "S_masked",
          "shape": "[batch, h, tgt_len, src_len]",
          "dtype": "float32",
          "description": "Masked attention scores"
        }
      ],
      "output_tensors": [
        {
          "name": "A",
          "shape": "[batch, h, tgt_len, src_len]",
          "dtype": "float32",
          "description": "Attention weights (per head)"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * tgt_len * src_len)",
      "numerical_stability_notes": "Use max-subtraction: softmax(x) = softmax(x - max(x, dim=-1)). Compute in float32 when using mixed precision."
    },
    {
      "id": "op_attn_dropout",
      "name": "attention_weights_dropout",
      "type": "dropout",
      "description": "Applies dropout to attention probabilities for regularization during training.",
      "mathematical_formula": "A' = \\text{Dropout}(A, p)",
      "input_tensors": [
        {
          "name": "A",
          "shape": "[batch, h, tgt_len, src_len]",
          "dtype": "float32",
          "description": "Attention weights"
