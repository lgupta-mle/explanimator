      ],
      "output_tensors": [
        {
          "name": "A_drop",
          "shape": "[batch, h, tgt_len, src_len]",
          "dtype": "float32",
          "description": "Attention weights after dropout"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "dropout_attn",
