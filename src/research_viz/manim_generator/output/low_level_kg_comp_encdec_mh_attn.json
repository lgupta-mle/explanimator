      "name": "layernorm_compute_mean",
      "type": "reduction",
      "description": "Computes the per-token mean across the feature dimension for layer normalization.",
      "mathematical_formula": "\\mu = \\frac{1}{d_{model}} \\sum_{i=1}^{d_{model}} R_i",
