        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * src_len * d_model * h*d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_bias",
      "name": "key_bias_add",
      "type": "elementwise",
      "description": "Adds bias to key projections.",
      "mathematical_formula": "K^{flat}_b = K^{flat} + b_K",
      "input_tensors": [
        {
          "name": "K_flat",
          "shape": "[batch, src_len, h*d_k]",
          "dtype": "float32",
          "description": "Projected keys"
        },
        {
          "name": "b_K",
          "shape": "[h*d_k]",
          "dtype": "float32",
