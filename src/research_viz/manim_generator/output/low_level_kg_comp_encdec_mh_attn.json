      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(batch * h * tgt_len * src_len * d_v)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_context_transpose",
      "name": "context_transpose_hstd_to_ts_hd",
      "type": "reshape",
      "description": "Moves the head dimension after the target length to prepare for concatenation.",
