  "composite_operations": [
    {
      "id": "comp_kv_projection",
      "name": "KV Projection (from encoder memory)",
      "description": "Projects encoder outputs into keys and values for all heads and rearranges their dimensions.",
      "atomic_operations_involved": [
        "op_k_mm",
        "op_k_bias",
        "op_k_reshape",
        "op_k_transpose",
        "op_v_mm",
        "op_v_bias",
        "op_v_reshape",
        "op_v_transpose"
      ],
      "overall_formula": "K = \\text{reshape\\_heads}(X_e W_K + b_K),\\quad V = \\text{reshape\\_heads}(X_e W_V + b_V)",
      "why_grouped": "Keys and values share the same source and are computed once to attend the entire target sequence."
    },
    {
      "id": "comp_q_projection",
      "name": "Q Projection (from decoder states)",
      "description": "Projects decoder hidden states to queries and splits into heads.",
      "atomic_operations_involved": [
        "op_q_mm",
        "op_q_bias",
        "op_q_reshape",
        "op_q_transpose"
      ],
      "overall_formula": "Q = \\text{reshape\\_heads}(X_d W_Q + b_Q)",
      "why_grouped": "Always executed together before attention."
    },
    {
      "id": "comp_scaled_dot_product_attention",
      "name": "Scaled Dot-Product Cross-Attention",
      "description": "Computes attention over encoder memory conditioned on decoder queries, including scaling, masking, softmax, and value aggregation.",
      "atomic_operations_involved": [
        "op_scores_matmul",
        "op_scale_scores",
        "op_apply_padding_mask",
        "op_softmax",
        "op_attn_dropout",
        "op_weighted_sum"
      ],
      "overall_formula": "C = \\text{softmax}\\!\\left( (QK^T)/\\sqrt{d_k} + M \\right) V",
      "why_grouped": "These steps form the core attention mechanism."
    },
    {
      "id": "comp_output_merge",
      "name": "Head Merge and Output Projection",
      "description": "Merges per-head contexts, projects to model dimension, applies dropout and residual connection followed by LayerNorm.",
      "atomic_operations_involved": [
        "op_context_transpose",
        "op_concat_heads",
        "op_out_mm",
        "op_out_bias",
        "op_sublayer_dropout",
        "op_residual_add",
        "op_ln_mean",
        "op_ln_var",
        "op_ln_norm",
        "op_ln_scale_shift"
      ],
      "overall_formula": "Y_{out} = \\text{LayerNorm}\\big(X_d + \\text{Dropout}((\\text{ConcatHeads}(C)) W_O + b_O)\\big)",
      "why_grouped": "This is the standard post-attention sequence in Transformer decoder blocks."
    }
  ],
  "tensor_transformations": [
    {
      "from_shape": "[batch, tgt_len, h*d_k]",
      "to_shape": "[batch, h, tgt_len, d_k]",
