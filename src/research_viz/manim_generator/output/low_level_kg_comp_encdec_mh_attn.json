      "type": "normalization",
      "description": "Normalizes the residual by subtracting mean and dividing by the standard deviation with epsilon for numerical stability.",
      "mathematical_formula": "\\hat{R} = (R - \\mu) / \\sqrt{\\sigma^2 + \\epsilon}",
      "input_tensors": [
