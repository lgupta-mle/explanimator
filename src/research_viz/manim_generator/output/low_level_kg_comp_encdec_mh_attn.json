        }
      ],
      "output_tensors": [
        {
          "name": "K_flat_b",
          "shape": "[batch, src_len, h*d_k]",
          "dtype": "float32",
          "description": "Biased key projections"
        }
      ],
      "parameters": [
        {
          "name": "b_K",
          "shape": "[h*d_k]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Bias for key projection"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * src_len * h*d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_reshape",
      "name": "key_reshape_split_heads",
      "type": "reshape",
      "description": "Reshapes flattened key dimension into [num_heads, d_k] per source token.",
      "mathematical_formula": "K' = \\text{reshape}(K^{flat}_b, [B, T_s, h, d_k])",
      "input_tensors": [
        {
          "name": "K_flat_b",
          "shape": "[batch, src_len, h*d_k]",
          "dtype": "float32",
          "description": "Biased key projections"
        }
      ],
      "output_tensors": [
        {
          "name": "K_split",
          "shape": "[batch, src_len, h, d_k]",
          "dtype": "float32",
          "description": "Keys split into heads"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_transpose",
      "name": "key_transpose_bhsd",
      "type": "reshape",
      "description": "Permutes dimensions to [batch, heads, src_len, d_k] for batched attention.",
      "mathematical_formula": "K = \\text{transpose}(K', [0, 2, 1, 3])",
      "input_tensors": [
        {
          "name": "K_split",
          "shape": "[batch, src_len, h, d_k]",
          "dtype": "float32",
          "description": "Keys split into heads"
        }
      ],
      "output_tensors": [
        {
          "name": "K",
          "shape": "[batch, h, src_len, d_k]",
          "dtype": "float32",
          "description": "Keys ready for attention"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_v_mm",
      "name": "value_matmul",
      "type": "matmul",
      "description": "Projects encoder memory into the value subspace using a learned weight matrix.",
      "mathematical_formula": "V^{flat} = X_e W_V",
      "input_tensors": [
