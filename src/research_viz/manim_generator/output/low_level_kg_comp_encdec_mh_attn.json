        }
      ],
      "computational_complexity": "O(batch * h * tgt_len * src_len)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_weighted_sum",
      "name": "attention_weighted_sum_values",
      "type": "matmul",
      "description": "Aggregates value vectors using attention weights to produce per-head context vectors.",
      "mathematical_formula": "C = A' V",
      "input_tensors": [
        {
          "name": "A_drop",
          "shape": "[batch, h, tgt_len, src_len]",
