    {
      "id": "op_v_bias",
      "name": "value_bias_add",
      "type": "elementwise",
      "description": "Adds bias to value projections.",
      "mathematical_formula": "V^{flat}_b = V^{flat} + b_V",
      "input_tensors": [
        {
          "name": "V_flat",
          "shape": "[batch, src_len, h*d_v]",
          "dtype": "float32",
          "description": "Projected values"
        },
        {
          "name": "b_V",
          "shape": "[h*d_v]",
