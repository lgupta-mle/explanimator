    },
    {
      "id": "op_v_reshape",
      "name": "value_reshape_split_heads",
      "type": "reshape",
      "description": "Reshapes flattened value dimension into [num_heads, d_v] per source token.",
      "mathematical_formula": "V' = \\text{reshape}(V^{flat}_b, [B, T_s, h, d_v])",
      "input_tensors": [
        {
          "name": "V_flat_b",
          "shape": "[batch, src_len, h*d_v]",
          "dtype": "float32",
          "description": "Biased value projections"
        }
      ],
      "output_tensors": [
        {
          "name": "V_split",
          "shape": "[batch, src_len, h, d_v]",
          "dtype": "float32",
