{
  "component_id": "comp_encdec_mh_attn",
  "component_name": "Encoder–Decoder Multi-Head Attention",
  "atomic_operations": [
    {
      "id": "op_q_mm",
      "name": "query_matmul",
      "type": "matmul",
      "description": "Projects decoder hidden states into the query subspace via a learned weight matrix. Performs a batched matrix multiplication over the last dimension.",
      "mathematical_formula": "Q^{flat} = X_d W_Q",
      "input_tensors": [
        {
          "name": "X_d",
          "shape": "[batch, tgt_len, d_model]",
          "dtype": "float32",
          "description": "Decoder hidden states from previous sub-layer (queries)"
        },
        {
          "name": "W_Q",
          "shape": "[d_model, h*d_k]",
          "dtype": "float32",
          "description": "Query projection weights"
        }
      ],
      "output_tensors": [
        {
          "name": "Q_flat",
          "shape": "[batch, tgt_len, h*d_k]",
          "dtype": "float32",
          "description": "Linearly projected queries before bias"
        }
      ],
      "parameters": [
        {
          "name": "W_Q",
          "shape": "[d_model, h*d_k]",
          "initialization": "Xavier uniform",
          "trainable": true,
          "description": "Query projection weight matrix"
        }
      ],
      "hyperparameters": [
        {
          "name": "d_model",
          "value": "512",
          "description": "Model hidden size"
        },
        {
          "name": "h",
          "value": "8",
          "description": "Number of attention heads"
        },
        {
          "name": "d_k",
          "value": "64",
          "description": "Per-head key/query dimension"
        }
      ],
      "computational_complexity": "O(batch * tgt_len * d_model * h*d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_q_bias",
      "name": "query_bias_add",
      "type": "elementwise",
      "description": "Adds a learned bias to the flattened query projections.",
      "mathematical_formula": "Q^{flat}_b = Q^{flat} + b_Q",
      "input_tensors": [
        {
          "name": "Q_flat",
          "shape": "[batch, tgt_len, h*d_k]",
          "dtype": "float32",
          "description": "Projected queries"
        },
        {
          "name": "b_Q",
          "shape": "[h*d_k]",
          "dtype": "float32",
          "description": "Query bias"
        }
      ],
      "output_tensors": [
        {
          "name": "Q_flat_b",
          "shape": "[batch, tgt_len, h*d_k]",
          "dtype": "float32",
          "description": "Biased query projections"
        }
      ],
      "parameters": [
        {
          "name": "b_Q",
          "shape": "[h*d_k]",
          "initialization": "zeros",
          "trainable": true,
          "description": "Bias for query projection"
        }
      ],
      "hyperparameters": [],
      "computational_complexity": "O(batch * tgt_len * h*d_k)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_q_reshape",
      "name": "query_reshape_split_heads",
      "type": "reshape",
      "description": "Reshapes the flattened query dimension into [num_heads, d_k] per token. Prepares for parallel attention across heads.",
      "mathematical_formula": "Q' = \\text{reshape}(Q^{flat}_b, [B, T_t, h, d_k])",
      "input_tensors": [
        {
          "name": "Q_flat_b",
          "shape": "[batch, tgt_len, h*d_k]",
          "dtype": "float32",
          "description": "Biased query projections"
        }
      ],
      "output_tensors": [
        {
          "name": "Q_split",
          "shape": "[batch, tgt_len, h, d_k]",
          "dtype": "float32",
          "description": "Queries split into heads"
        }
      ],
      "parameters": [],
      "hyperparameters": [
        {
          "name": "h",
          "value": "8",
          "description": "Number of heads"
        },
        {
          "name": "d_k",
          "value": "64",
          "description": "Head dimension"
        }
      ],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_q_transpose",
      "name": "query_transpose_bhsd",
      "type": "reshape",
      "description": "Permutes dimensions to place heads before sequence length for efficient batched matmul.",
      "mathematical_formula": "Q = \\text{transpose}(Q', [0, 2, 1, 3])",
      "input_tensors": [
        {
          "name": "Q_split",
          "shape": "[batch, tgt_len, h, d_k]",
          "dtype": "float32",
          "description": "Queries split into heads"
        }
      ],
      "output_tensors": [
        {
          "name": "Q",
          "shape": "[batch, h, tgt_len, d_k]",
          "dtype": "float32",
          "description": "Queries ready for attention"
        }
      ],
      "parameters": [],
      "hyperparameters": [],
      "computational_complexity": "O(1)",
      "numerical_stability_notes": null
    },
    {
      "id": "op_k_mm",
      "name": "key_matmul",
      "type": "matmul",
      "description": "Projects encoder memory into the key subspace using a learned weight matrix.",
      "mathematical_formula": "K^{flat} = X_e W_K",
      "input_tensors": [
